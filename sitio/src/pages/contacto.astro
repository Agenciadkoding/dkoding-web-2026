---
/**
 * /contacto/ · Tres vías (WhatsApp, llamada, correo), formulario con origen y consentimiento,
 * datos de contacto y enlaces a soporte y cotizador.
 */
import Base from '../layouts/Base.astro';
import Consentimiento from '../components/Consentimiento.astro';
import { SITIO, waLink } from '../data/sitio';
import { migasSchema } from '../data/schema';

const WA_CONTACTO = waLink('Hola DKODING, quiero hablar de mi proyecto.');
const ICONO_WA = 'M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z';
const ICONO_TEL = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z';
const ORIGENES = ['Google', 'ChatGPT u otra IA', 'Redes sociales', 'Recomendación', 'Otro'];

const schema = [
  migasSchema([{ nombre: 'Inicio', url: '/' }, { nombre: 'Contacto', url: '/contacto/' }]),
  {
    '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contacto DKODING', url: `${SITIO.dominio}/contacto/`,
    description: 'Habla con DKODING por WhatsApp, llamada, correo o formulario. Agencia de desarrollo web y marketing digital en Cali, Colombia.',
    mainEntity: { '@id': `${SITIO.dominio}/#organizacion` },
  },
];
---
<Base
  titulo="Contacto: hablemos de tu proyecto en Cali"
  descripcion="Escríbenos por WhatsApp, llámanos o envíanos el formulario. DKODING, agencia de desarrollo web y marketing digital en Cali, responde en horario hábil. Si ya eres cliente, abre un ticket."
  ruta="/contacto/"
  schema={schema}
>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-in">
      <p class="eyebrow">Contacto</p>
      <h1>Contacto: <strong>hablemos de tu proyecto</strong> en Cali</h1>
      <p class="lead">Si quieres una página web, posicionar tu negocio en Google y en la IA, mover tus redes o crear tu marca, este es el lugar. Elige la vía que prefieras: WhatsApp, una llamada, un correo o el formulario de abajo. Atendemos desde Cali a empresas de toda Colombia y respondemos en horario hábil.</p>
    </div>
  </section>

  <section class="container vias" aria-labelledby="h-vias">
    <h2 id="h-vias" class="visually-hidden">Tres formas de hablar con nosotros</h2>
    <div class="vias-grid">
      <article class="via">
        <span class="ic ic-wa" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={ICONO_WA}/></svg></span>
        <h3>WhatsApp</h3>
        <p class="muted">La vía más rápida. Te respondemos en horario hábil, con una persona del equipo.</p>
        <a class="btn btn-wa abajo" href={WA_CONTACTO} target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </article>
      <article class="via">
        <span class="ic ic-lila" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={ICONO_TEL}/></svg></span>
        <h3>Llámanos</h3>
        <p class="muted">{SITIO.horario} Si no alcanzamos a contestar, te devolvemos la llamada.</p>
        <a class="btn btn-secondary abajo" href={SITIO.telefonoHref}>{SITIO.telefono}</a>
      </article>
      <article class="via">
        <span class="ic ic-lila" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M3 7l9 6 9-6"/></svg></span>
        <h3>Correo</h3>
        <p class="muted">Para propuestas, facturación o documentos. Te respondemos en un día hábil.</p>
        <a class="btn btn-secondary abajo correo" href={`mailto:${SITIO.correo}`}>{SITIO.correo}</a>
      </article>
    </div>
  </section>

  <section class="container section-tight dos" aria-labelledby="h-form">
    <div class="card form-card">
      <h2 id="h-form">Cuéntanos qué necesitas</h2>
      <p class="muted">Te respondemos con una propuesta o con las preguntas que haga falta resolver antes.</p>
      <form class="form" novalidate data-form-contacto>
        <div class="grid grid-2">
          <div class="field">
            <label for="ct-nombre">Nombre <span class="req" aria-hidden="true">*</span></label>
            <input id="ct-nombre" class="input" name="nombre" type="text" autocomplete="name" required aria-describedby="ct-nombre-err">
            <span id="ct-nombre-err" class="error-msg" hidden>Escribe tu nombre.</span>
          </div>
          <div class="field">
            <label for="ct-empresa">Empresa <span class="opcional">opcional</span></label>
            <input id="ct-empresa" class="input" name="empresa" type="text" autocomplete="organization">
          </div>
          <div class="field">
            <label for="ct-tel">Celular o WhatsApp <span class="req" aria-hidden="true">*</span></label>
            <input id="ct-tel" class="input" name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="300 000 0000" required aria-describedby="ct-tel-err">
            <span id="ct-tel-err" class="error-msg" hidden>Escribe un celular válido.</span>
          </div>
          <div class="field">
            <label for="ct-correo">Correo <span class="req" aria-hidden="true">*</span></label>
            <input id="ct-correo" class="input" name="correo" type="email" inputmode="email" autocomplete="email" placeholder="tu@empresa.com" required aria-describedby="ct-correo-err">
            <span id="ct-correo-err" class="error-msg" hidden>Revisa el correo: falta algo.</span>
          </div>
        </div>
        <div class="field">
          <label for="ct-mensaje">Mensaje <span class="req" aria-hidden="true">*</span></label>
          <textarea id="ct-mensaje" class="input" name="mensaje" rows="5" placeholder="Cuéntanos qué vendes, qué necesitas y para cuándo" required aria-describedby="ct-mensaje-err"></textarea>
          <span id="ct-mensaje-err" class="error-msg" hidden>Cuéntanos qué necesitas.</span>
        </div>
        <div class="field">
          <label for="ct-origen">¿Cómo nos conociste?</label>
          <select id="ct-origen" class="input" name="como_nos_conocio">
            <option value="">Elige una opción</option>
            {ORIGENES.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
        <Consentimiento id="ct-datos" />
        <div class="hp" aria-hidden="true"><label for="ct-hp">No llenar</label><input id="ct-hp" type="text" name="sitio_web2" tabindex="-1" autocomplete="off"></div>
        <div class="form-estado" role="alert" hidden data-estado>
          <p data-estado-txt></p>
          <a class="btn btn-wa btn-sm" href={WA_CONTACTO} data-estado-wa target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
        <div class="acciones">
          <button type="submit" class="btn btn-primary btn-lg" data-enviar>Enviar mensaje<span class="chev" aria-hidden="true">»</span></button>
          <a class="btn btn-wa" href={WA_CONTACTO} data-wa-alt target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_WA}/></svg>Mejor por WhatsApp</a>
        </div>
        <p class="small muted">Los campos con <span class="req" aria-hidden="true">*</span> son obligatorios.</p>
      </form>
      <div class="ok-box" role="status" hidden data-ok>
        <p class="ok-titulo"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="var(--dk-ok)"/></svg>Mensaje recibido</p>
        <p class="soft" data-ok-txt></p>
        <p class="small muted">Te respondemos en horario hábil. Si es urgente, escríbenos por WhatsApp.</p>
        <a class="btn btn-wa btn-sm" href={WA_CONTACTO} data-ok-wa target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </div>

    <aside class="lado">
      <div class="card">
        <h2 class="h-min">Dónde estamos</h2>
        <address class="datos">
          <p><strong>DKODING</strong><br>{SITIO.direccion}<br>{SITIO.ciudad}, {SITIO.region}, {SITIO.pais}</p>
          <p class="muted">{SITIO.horario}</p>
          <p><a href={SITIO.telefonoHref}>{SITIO.telefono}</a><br><a href={`mailto:${SITIO.correo}`}>{SITIO.correo}</a></p>
        </address>
      </div>
      <div class="card card-hl">
        <h2 class="h-min">¿Ya eres cliente?</h2>
        <p class="soft">Abre un ticket de soporte técnico, servicio al cliente o asesoría comercial. Recibes un número y un tiempo de primera respuesta por escrito.</p>
        <a class="btn-link" href="/soporte/">Abrir un ticket</a>
      </div>
      <div class="card">
        <h2 class="h-min">¿Quieres un precio ya?</h2>
        <p class="soft">Arma tu proyecto en el cotizador y recibe un estimado en minutos, sin compromiso.</p>
        <a class="btn-link" href="/cotizador/">Ir al cotizador</a>
      </div>
    </aside>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .small { font-size: 14px; }
  .req { color: var(--dk-lila); }
  .opcional { margin-left: 6px; font-size: 12px; font-weight: 400; color: var(--dk-muted); }
  .chev { font-family: var(--font-title); font-weight: 700; font-size: 18px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .abajo { margin-top: auto; }
  .h-min { font-weight: 700; font-size: 22px; line-height: 1.1; }

  .hero { position: relative; }
  .glow { position: absolute; inset: 0; background: radial-gradient(55% 80% at 50% 0%, rgba(109, 0, 194, 0.28), rgba(109, 0, 194, 0) 70%); pointer-events: none; }
  .hero-in { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; padding-block: clamp(48px, 6vw, 72px) clamp(28px, 3vw, 40px); }
  .hero h1 { max-width: 960px; font-size: clamp(36px, 4.6vw, 64px); }
  .hero .lead { text-align: center; }

  .vias-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 20px; }
  .via { display: flex; flex-direction: column; gap: 12px; padding: 24px; background: var(--dk-surface); border: 1px solid var(--dk-line); border-radius: var(--r-card); }
  .via h3 { font-size: 24px; }
  .ic { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--r-card); }
  .ic-wa { background: rgba(37, 211, 102, 0.12); color: var(--dk-wa); }
  .ic-lila { background: rgba(199, 85, 239, 0.14); color: var(--dk-lila); }
  .correo { overflow-wrap: anywhere; }

  .dos { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  @media (max-width: 900px) { .dos { grid-template-columns: minmax(0, 1fr); } }
  .form-card { display: flex; flex-direction: column; gap: 14px; }
  .form-card h2 { font-weight: 700; font-size: clamp(26px, 2.6vw, 34px); }
  .form { display: flex; flex-direction: column; gap: 14px; margin-top: 6px; }
  .form select.input { appearance: auto; }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .form-estado { display: flex; flex-direction: column; gap: 10px; padding: 12px 14px; background: rgba(255, 107, 107, 0.08); border: 1px solid rgba(255, 107, 107, 0.4); border-radius: var(--r-card); font-size: 14px; }
  .form-estado .btn { align-self: flex-start; }
  .ok-box { display: flex; flex-direction: column; gap: 10px; padding: 16px; background: rgba(91, 228, 155, 0.07); border: 1px solid rgba(91, 228, 155, 0.35); border-radius: var(--r-card); }
  .ok-box .btn { align-self: flex-start; }
  .ok-titulo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; }
  .btn[aria-busy="true"] { opacity: 0.7; pointer-events: none; }

  .lado { display: flex; flex-direction: column; gap: 16px; }
  .lado .card { display: flex; flex-direction: column; gap: 10px; }
  .datos { font-style: normal; display: flex; flex-direction: column; gap: 8px; }
</style>

<script>
  import { enviarFormulario, marcarTiempo } from '../scripts/formulario';
  const WA = (texto: string) => `https://api.whatsapp.com/send/?phone=573002867104&text=${encodeURIComponent(texto)}`;
  const form = document.querySelector<HTMLFormElement>('[data-form-contacto]');
  if (form) {
    marcarTiempo(form);
    const q = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
    const nombre = q<HTMLInputElement>('#ct-nombre'), empresa = q<HTMLInputElement>('#ct-empresa'), tel = q<HTMLInputElement>('#ct-tel'), correo = q<HTMLInputElement>('#ct-correo');
    const mensaje = q<HTMLTextAreaElement>('#ct-mensaje'), origen = q<HTMLSelectElement>('#ct-origen'), datos = q<HTMLInputElement>('#ct-datos');
    const waAlt = q<HTMLAnchorElement>('[data-wa-alt]'), estadoBox = q<HTMLElement>('[data-estado]'), enviar = q<HTMLButtonElement>('[data-enviar]');
    const okBox = document.querySelector<HTMLElement>('[data-ok]')!;

    function marcar(c: HTMLInputElement | HTMLTextAreaElement, malo: boolean) {
      c.setAttribute('aria-invalid', String(malo));
      const err = document.getElementById(c.id + '-err'); if (err) err.hidden = !malo;
      return !malo;
    }
    function armarWa() {
      const partes = [`Hola DKODING, soy ${nombre.value.trim() || '…'}`, empresa.value.trim() && `de ${empresa.value.trim()}`].filter(Boolean).join(' ');
      waAlt.href = WA(`${partes}. ${mensaje.value.trim() || 'Quiero hablar de mi proyecto.'}`);
    }
    form.addEventListener('input', (e) => {
      const c = e.target as HTMLInputElement;
      if (c.getAttribute('aria-invalid') === 'true') marcar(c, false);
      armarWa();
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const ok = [
        marcar(nombre, !nombre.value.trim()), marcar(tel, tel.value.replace(/\D/g, '').length < 7),
        marcar(correo, !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo.value.trim())), marcar(mensaje, !mensaje.value.trim()), marcar(datos, !datos.checked),
      ].every(Boolean);
      if (!ok) { form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus(); return; }
      estadoBox.hidden = true;
      enviar.setAttribute('aria-busy', 'true'); const html = enviar.innerHTML; enviar.textContent = 'Enviando…';
      const r = await enviarFormulario(form, { tipo: 'contacto', comoNosConocio: origen.value || undefined });
      enviar.setAttribute('aria-busy', 'false'); enviar.innerHTML = html;
      if (!r.ok) {
        estadoBox.hidden = false; q<HTMLElement>('[data-estado-txt]').textContent = r.error ?? 'No pudimos enviar el mensaje.';
        q<HTMLAnchorElement>('[data-estado-wa]').href = waAlt.href; return;
      }
      okBox.querySelector<HTMLElement>('[data-ok-txt]')!.textContent = `${nombre.value.trim().split(' ')[0]}, recibimos tu mensaje${r.numero ? ` con el número ${r.numero}` : ''}. Te escribimos a ${correo.value.trim()} o al ${tel.value.trim()}.`;
      okBox.querySelector<HTMLAnchorElement>('[data-ok-wa]')!.href = WA(`Hola DKODING, acabo de enviar el mensaje ${r.numero ?? ''} desde la web.`);
      form.hidden = true; okBox.hidden = false; okBox.focus?.();
    });
  }
</script>
