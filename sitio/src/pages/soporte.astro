  /* Ver mis tickets */
  .mis-tickets { flex-direction: row; flex-wrap: wrap; gap: 24px 40px; padding: 28px; }
  .mis-col { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
