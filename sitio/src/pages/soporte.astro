  .glow { position: absolute; inset: 0 0 auto 0; height: 420px; background: radial-gradient(60% 70% at 50% 0%, rgba(109, 0, 194, 0.28), rgba(109, 0, 194, 0) 70%); pointer-events: none; }
  .portada, .listo { position: relative; display: flex; flex-direction: column; gap: 32px; padding-block: clamp(40px, 5vw, 64px); }
