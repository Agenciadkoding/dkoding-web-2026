---
/**
 * /soporte/ · Centro de ayuda: WhatsApp, solicitud de llamada y ticket en 3 pasos.
 * Tres vistas en una sola página (portada, ticket, confirmación) alternadas con `hidden`;
 * todo el texto está en el HTML desde el inicio. Portado de diseno/admin/Soporte.dc.html.
 */
import Base from '../layouts/Base.astro';
import Consentimiento from '../components/Consentimiento.astro';
import { SITIO, waLink } from '../data/sitio';
import { migasSchema } from '../data/schema';

const TIPOS = [
  { id: 'cliente', nombre: 'Servicio al cliente', desc: 'Dudas, capacitación, cambios en tu sitio.', nota: '', sla: '1 día hábil',
    icono: 'M4 13v-1a8 8 0 0 1 16 0v1 M4 13a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2z M20 13a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2z M17 17v1a3 3 0 0 1-3 3h-2' },
  { id: 'comercial', nombre: 'Asesoría comercial', desc: 'Cotizaciones, nuevos servicios, facturación.', nota: 'Te atiende el equipo comercial', sla: 'el mismo día hábil',
    icono: 'M3 8h18v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z M8 8V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3 M3 13h18' },
  { id: 'tecnico', nombre: 'Soporte técnico', desc: 'Fallas, sitio caído, correo, hosting.', nota: '', sla: '4 horas hábiles',
    icono: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z' },
];

const SERVICIOS_TK = [
  { id: 'web', nombre: 'Sitio web o tienda virtual', icono: 'M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M3 9h18 M6.5 6.5h.01 M9 6.5h.01' },
  { id: 'hosting', nombre: 'Hosting y dominio', icono: 'M4 4h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M4 13h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z M7 7.5h.01 M7 16.5h.01 M11 7.5h6 M11 16.5h6' },
  { id: 'correo', nombre: 'Correo corporativo', icono: 'M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M3 7l9 6 9-6' },
  { id: 'marca', nombre: 'Diseño de marca', icono: 'M12 19l7-7 3 3-7 7z M18 13l-1.5-7.5L2 2l3.5 14.5L13 18z M2 2l7.6 7.6 M13 11a2 2 0 1 1-4 0a2 2 0 0 1 4 0z' },
  { id: 'marketing', nombre: 'Marketing digital y pauta', icono: 'M3 10v4a1 1 0 0 0 1 1h3l6 4V5L7 9H4a1 1 0 0 0-1 1z M16.5 8.5a5 5 0 0 1 0 7 M19 6a8.5 8.5 0 0 1 0 12' },
  { id: 'seo', nombre: 'SEO y GEO', icono: 'M17 10.5a6.5 6.5 0 1 1-13 0a6.5 6.5 0 0 1 13 0z M20 20l-4.8-4.8 M7.5 12l2-2 1.5 1.5 2.5-3' },
  { id: 'redes', nombre: 'Manejo de redes sociales', icono: 'M21 5a3 3 0 1 1-6 0a3 3 0 0 1 6 0z M9 12a3 3 0 1 1-6 0a3 3 0 0 1 6 0z M21 19a3 3 0 1 1-6 0a3 3 0 0 1 6 0z M8.6 13.5l6.8 4 M15.4 6.5l-6.8 4' },
  { id: 'apps', nombre: 'Desarrollo de apps', icono: 'M9 2h6a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M11 18h2' },
  { id: 'dkard', nombre: 'dkard.co (tarjeta digital)', icono: 'M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M10.5 12a2.5 2.5 0 1 1-5 0a2.5 2.5 0 0 1 5 0z M13 10h5 M13 14h3' },
  { id: 'otro', nombre: 'Otro', icono: 'M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0z M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7 M12 17h.01' },
];

const FRANJAS = ['Mañana (8:00 a. m. a 12:00 m.)', 'Tarde (2:00 p. m. a 6:00 p. m.)', 'Cualquier hora hábil'];

const WA_AYUDA = waLink('Hola, necesito ayuda de DKODING.');
const WA_LLAMADA = waLink('Hola DKODING, quiero que me llamen. Mi nombre es ');
const ICONO_WA = 'M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z';
const ICONO_TEL = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z';

const schema = [migasSchema([{ nombre: 'Inicio', url: '/' }, { nombre: 'Centro de ayuda', url: '/soporte/' }])];
---
<Base
  titulo="Centro de ayuda y soporte técnico"
  descripcion="Centro de ayuda de DKODING: escríbenos por WhatsApp, pide una llamada o abre un ticket. Primera respuesta con tiempo por escrito."
  ruta="/soporte/"
  schema={schema}
>
  <!-- ===== 1 · PORTADA ===== -->
  <div class="vista" data-vista="portada">
    <div class="glow" aria-hidden="true"></div>
    <div class="container portada">
      <header class="hero">
        <p class="eyebrow">Soporte DKODING</p>
        <h1 tabindex="-1">Centro de <strong>ayuda</strong> y soporte técnico</h1>
        <p class="lead">Escríbenos por WhatsApp, pide que te llamemos o abre un ticket. Es el centro de ayuda de DKODING para clientes con sitio web, hosting, correo, marca, pauta o SEO en Medellín y fuera. Cada solicitud queda registrada con un número y te respondemos en horario hábil, con un tiempo de primera respuesta por escrito.</p>
      </header>

      <div class="tres">
        <!-- WhatsApp -->
        <section class="tarjeta" aria-labelledby="h-wa">
          <div class="tarjeta-h">
            <span class="ic ic-wa" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={ICONO_WA}/><path d="M9 9.5c.3 1.6 1.9 3.4 3.6 4.1l1.2-1.1 1.7.8-.3 1.3c-2.9.3-6.2-2.8-6.4-5.6l1.3-.4.8 1.7z"/></svg></span>
            <h2 id="h-wa">Escríbenos por WhatsApp</h2>
          </div>
          <div class="field">
            <label for="wa-msg">Escribe tu mensaje</label>
            <textarea id="wa-msg" class="input" rows="3" placeholder="Hola, necesito ayuda con…" data-wa-texto></textarea>
          </div>
          <p class="small muted">Número público: <a class="tel" href={SITIO.telefonoHref}>{SITIO.telefono}</a></p>
          <a class="btn btn-wa abajo" href={WA_AYUDA} data-wa-btn target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_WA}/></svg>Enviar por WhatsApp</a>
        </section>

        <!-- Solicita una llamada -->
        <section class="tarjeta" aria-labelledby="h-llamada">
          <div class="tarjeta-h">
            <span class="ic ic-lila" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={ICONO_TEL}/></svg></span>
            <h2 id="h-llamada">Solicita una llamada</h2>
          </div>
          <form class="form-llamada" novalidate data-form-llamada>
            <div class="field">
              <label for="ll-nombre">Nombre completo <span class="req" aria-hidden="true">*</span></label>
              <input id="ll-nombre" class="input" name="nombre" type="text" autocomplete="name" required aria-describedby="ll-nombre-err">
              <span id="ll-nombre-err" class="error-msg" hidden>Escribe tu nombre completo.</span>
            </div>
            <div class="field">
              <label for="ll-tel">Celular <span class="req" aria-hidden="true">*</span></label>
              <input id="ll-tel" class="input" name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="300 000 0000" required aria-describedby="ll-tel-err">
              <span id="ll-tel-err" class="error-msg" hidden>Escribe un celular válido (10 dígitos en Colombia).</span>
            </div>
            <div class="field">
              <label for="ll-franja">Franja horaria</label>
              <select id="ll-franja" class="input" name="franja">
                {FRANJAS.map((f) => <option value={f}>{f}</option>)}
              </select>
            </div>
            <div class="hp" aria-hidden="true"><label for="ll-hp">No llenar</label><input id="ll-hp" type="text" name="sitio_web2" tabindex="-1" autocomplete="off"></div>
            <div class="form-estado" role="alert" hidden data-estado>
              <p data-estado-txt></p>
              <a class="btn btn-wa btn-sm" href={WA_LLAMADA} data-estado-wa target="_blank" rel="noopener">Escribir por WhatsApp</a>
            </div>
            <button type="submit" class="btn btn-secondary abajo" data-enviar>Solicitar llamada</button>
          </form>
          <div class="ok-box" role="status" hidden data-llamada-ok>
            <p class="ok-titulo"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="var(--dk-ok)"/></svg>Te llamamos en horario hábil</p>
            <p class="soft" data-llamada-txt></p>
            <p class="small muted">Tu solicitud ya está en nuestra lista de llamadas por devolver. Si es urgente, escríbenos por WhatsApp.</p>
            <button type="button" class="btn-link sin-chev" data-llamada-otra>Pedir otra llamada</button>
          </div>
        </section>

        <!-- Crear ticket -->
        <section class="tarjeta tarjeta-deep" aria-labelledby="h-tk">
          <div class="tarjeta-h">
            <span class="ic ic-lila" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4z"/><path d="M14 5v2M14 11v2M14 17v2"/></svg></span>
            <h2 id="h-tk">Crear ticket</h2>
          </div>
          <p class="soft">Para servicio al cliente, asesoría comercial o soporte técnico.</p>
          <ul class="chev-list small soft">
            <li>Recibes un número para seguirlo</li>
            <li>Tiempo de primera respuesta por escrito</li>
            <li>Si tienes capturas, las envías por WhatsApp citando tu número</li>
          </ul>
          <button type="button" class="btn btn-primary abajo" data-ir="ticket">Crear ticket<span class="chev" aria-hidden="true">»</span></button>
        </section>
      </div>

      <!-- Ver mis tickets: pronto -->
      <section class="tarjeta mis-tickets" aria-labelledby="h-mis">
        <div class="mis-col">
          <div class="mis-titulo"><h2 id="h-mis">Ver mis tickets</h2><span class="pill pill-lila">Pronto</span></div>
          <p class="muted">Sin registro ni contraseña: escribirás el correo con el que abriste tus tickets y te enviaremos un enlace de acceso para ver su estado.</p>
        </div>
        <div class="mis-col">
          <p class="soft">Mientras tanto, responde al correo de confirmación de tu ticket o escríbenos por WhatsApp citando tu número.</p>
          <ol class="pasos-mini">
            <li><span class="badge" aria-hidden="true">1</span>Escribes tu correo</li>
            <li><span class="badge" aria-hidden="true">2</span>Abres el enlace que te llega</li>
            <li><span class="badge" aria-hidden="true">3</span>Ves tus tickets y su estado</li>
          </ol>
        </div>
      </section>
    </div>
  </div>

  <!-- ===== 2 · CREAR TICKET EN 3 PASOS ===== -->
  <div class="vista" data-vista="ticket" hidden>
    <div class="container-wide ticket">
      <aside class="lateral" aria-label="Otros canales">
        <div class="tarjeta compacta">
          <h2 class="h-min">¿Prefieres escribir?</h2>
          <div class="field">
            <label for="wa-msg-2">Escribe tu mensaje</label>
            <input id="wa-msg-2" class="input" type="text" placeholder="Hola, necesito ayuda con…" data-wa-texto>
          </div>
          <p class="small muted">{SITIO.telefono}</p>
          <a class="btn btn-wa" href={WA_AYUDA} data-wa-btn target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_WA}/></svg>Enviar por WhatsApp</a>
        </div>
        <div class="tarjeta compacta">
          <h2 class="h-min">Primera respuesta por escrito</h2>
          <ul class="sla-lista">
            {TIPOS.map((t) => <li><span class="soft">{t.nombre}</span><strong>{t.sla}</strong></li>)}
          </ul>
          <p class="small muted">Horario hábil: {SITIO.horario}</p>
        </div>
        <button type="button" class="btn btn-secondary" data-ir="portada" data-foco="h-llamada">Solicita una llamada</button>
      </aside>

      <div class="pasos-col">
        <div class="pasos-cab">
          <button type="button" class="volver" data-ir="portada"><span aria-hidden="true">‹</span>Volver al centro de ayuda</button>
          <h2 class="titulo-vista" tabindex="-1">Crear <strong>ticket</strong></h2>
        </div>

        <nav aria-label="Pasos del ticket">
          <ol class="pasos-nav">
            <li><button type="button" class="paso-btn is-cur" data-paso="1" aria-current="step"><span class="badge" aria-hidden="true" data-badge>1</span><span class="paso-txt"><strong>1. Tipo de ayuda</strong><span class="paso-val" data-val="tipo">sin elegir</span></span></button></li>
            <li><button type="button" class="paso-btn" data-paso="2"><span class="badge" aria-hidden="true" data-badge>2</span><span class="paso-txt"><strong>2. Servicio</strong><span class="paso-val" data-val="servicio">sin elegir</span></span></button></li>
            <li><button type="button" class="paso-btn" data-paso="3"><span class="badge" aria-hidden="true" data-badge>3</span><span class="paso-txt"><strong>3. Tu ticket</strong><span class="paso-val">datos y mensaje</span></span></button></li>
          </ol>
        </nav>

        <div class="paneles">
          <!-- Paso 1 -->
          <section class="panel is-cur" data-panel="1" aria-labelledby="h-s1">
            <div class="panel-h"><h3 id="h-s1">1. Tipo de ayuda</h3><span class="small muted">Según tu necesidad, elige una opción</span></div>
            <div class="opciones" role="group" aria-label="Tipo de ayuda">
              {TIPOS.map((t) => (
                <button type="button" class="opcion" data-tipo={t.id} data-nombre={t.nombre} data-sla={t.sla} aria-pressed="false" aria-describedby={`tipo-${t.id}-desc`}>
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icono}/></svg>
                  <span class="opcion-txt">
                    <strong>{t.nombre}</strong>
                    <span id={`tipo-${t.id}-desc`} class="opcion-desc"><span class="small muted">{t.desc}</span>{t.nota && <span class="pill pill-lila">{t.nota}</span>}</span>
                  </span>
                  <span class="radio" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          </section>

          <!-- Paso 2 -->
          <section class="panel" data-panel="2" aria-labelledby="h-s2">
            <div class="panel-h"><h3 id="h-s2">2. ¿Sobre qué servicio?</h3><span class="small muted">Elige el servicio con el que necesitas ayuda</span></div>
            <div class="servicios" role="group" aria-label="Servicio">
              {SERVICIOS_TK.map((s) => (
                <button type="button" class="opcion opcion-sv" data-servicio={s.id} data-nombre={s.nombre} aria-pressed="false">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icono}/></svg>
                  <span class="opcion-sv-txt">{s.nombre}</span>
                </button>
              ))}
            </div>
          </section>

          <!-- Paso 3 -->
          <section class="panel" data-panel="3" aria-labelledby="h-s3">
            <div class="panel-h"><h3 id="h-s3">3. Tu ticket</h3><span class="small muted">Completa el formulario para terminar</span></div>
            <div class="resumen" aria-label="Resumen de lo elegido">
              <div class="resumen-fila"><span class="resumen-k">Tipo de ayuda<strong data-out="tipo" class="muted">Sin elegir</strong></span><button type="button" class="btn-link sin-chev" data-paso="1">Cambiar</button></div>
              <div class="resumen-fila"><span class="resumen-k">Servicio<strong data-out="servicio" class="muted">Sin elegir</strong></span><button type="button" class="btn-link sin-chev" data-paso="2">Cambiar</button></div>
              <p class="resumen-sla small" data-out="sla-texto">El tiempo de primera respuesta depende del tipo de ayuda</p>
            </div>

            <form class="form-ticket" novalidate data-form-ticket>
              <div class="alerta" role="alert" hidden data-alerta>
                <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1L15 8L8 15L1 8z" fill="var(--dk-crit)"/></svg>
                <span data-alerta-txt>Faltan datos para enviar el ticket. Están marcados en cada campo.</span>
              </div>
              <div class="field">
                <label for="tk-nombre">Nombre completo <span class="req" aria-hidden="true">*</span></label>
                <input id="tk-nombre" class="input" name="nombre" type="text" autocomplete="name" required aria-describedby="tk-nombre-err">
                <span id="tk-nombre-err" class="error-msg" hidden>Escribe tu nombre completo.</span>
              </div>
              <div class="field">
                <label for="tk-correo">Correo electrónico <span class="req" aria-hidden="true">*</span></label>
                <input id="tk-correo" class="input" name="correo" type="email" autocomplete="email" inputmode="email" placeholder="tu@empresa.com" required aria-describedby="tk-correo-err">
                <span id="tk-correo-err" class="error-msg" hidden>Revisa el correo: falta algo.</span>
              </div>
              <div class="field">
                <label for="tk-tel">Celular o WhatsApp <span class="req" aria-hidden="true">*</span></label>
                <input id="tk-tel" class="input" name="telefono" type="tel" autocomplete="tel" inputmode="tel" placeholder="300 000 0000" required aria-describedby="tk-tel-err">
                <span id="tk-tel-err" class="error-msg" hidden>Escribe un celular válido (10 dígitos en Colombia).</span>
              </div>
              <div class="field">
                <label for="tk-sitio">Sitio web <span class="opcional">opcional</span></label>
                <input id="tk-sitio" class="input" name="sitio" type="text" autocomplete="url" inputmode="url" placeholder="tusitio.com">
              </div>
              <div class="field">
                <label for="tk-asunto">Asunto <span class="req" aria-hidden="true">*</span></label>
                <input id="tk-asunto" class="input" name="asunto" type="text" maxlength="120" placeholder="Ej.: el formulario de contacto no envía" required aria-describedby="tk-asunto-err">
                <span id="tk-asunto-err" class="error-msg" hidden>Escribe un asunto corto.</span>
              </div>
              <div class="field">
                <label for="tk-desc">Descripción <span class="req" aria-hidden="true">*</span></label>
                <textarea id="tk-desc" class="input" name="mensaje" rows="5" placeholder="Cuéntanos qué pasa, desde cuándo y en qué página" required aria-describedby="tk-desc-err"></textarea>
                <span id="tk-desc-err" class="error-msg" hidden>Cuéntanos qué pasa.</span>
                <span class="hint">Si tienes capturas, envíalas por WhatsApp citando tu número de ticket.</span>
              </div>
              <Consentimiento id="tk-datos" />
              <div class="hp" aria-hidden="true"><label for="tk-hp">No llenar</label><input id="tk-hp" type="text" name="sitio_web2" tabindex="-1" autocomplete="off"></div>
              <div class="form-estado" role="alert" hidden data-estado>
                <p data-estado-txt></p>
                <a class="btn btn-wa btn-sm" href={WA_AYUDA} data-estado-wa target="_blank" rel="noopener">Escribir por WhatsApp</a>
              </div>
              <div class="acciones">
                <button type="submit" class="btn btn-primary btn-lg" data-enviar>Enviar ticket<span class="chev" aria-hidden="true">»</span></button>
                <a class="btn btn-wa" href={WA_AYUDA} data-wa-ticket target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_WA}/></svg>Mejor por WhatsApp</a>
              </div>
              <p class="small muted">Los campos con <span class="req" aria-hidden="true">*</span> son obligatorios.</p>
            </form>
          </section>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== 3 · CONFIRMACIÓN ===== -->
  <div class="vista" data-vista="listo" hidden>
    <div class="glow" aria-hidden="true"></div>
    <div class="container listo">
      <header class="hero">
        <svg width="44" height="44" viewBox="0 0 16 16" role="img" aria-label="Ticket creado"><circle cx="8" cy="8" r="6" fill="var(--dk-ok)"/><path d="M5.5 8.2l1.7 1.7 3.4-3.6" fill="none" stroke="#0C0C0C" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <p class="eyebrow">Ticket creado</p>
        <h2 class="titulo-vista" tabindex="-1">Tu ticket es el <strong class="nowrap" data-out="numero">—</strong></h2>
        <p class="lead centrado">Te enviamos una copia a tu correo para que lo tengas a mano: <strong data-out="correo"></strong></p>
      </header>
      <div class="sla-box">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--dk-lila)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span class="sla-main"><span class="small soft">Primera respuesta · compromiso por escrito</span><strong class="sla-valor" data-out="sla">—</strong></span>
        <span class="small soft">Soporte técnico: 4 horas hábiles. Servicio al cliente: 1 día hábil. Asesoría comercial: el mismo día hábil.</span>
      </div>
      <section class="tarjeta" aria-labelledby="h-resumen">
        <h2 id="h-resumen" class="h-min">Resumen</h2>
        <dl class="resumen-dl">
          <div><dt>Tipo de ayuda</dt><dd data-out="r-tipo"></dd></div>
          <div><dt>Servicio</dt><dd data-out="r-servicio"></dd></div>
          <div><dt>Nombre</dt><dd data-out="r-nombre"></dd></div>
          <div><dt>Correo</dt><dd data-out="r-correo"></dd></div>
          <div><dt>Celular</dt><dd data-out="r-tel"></dd></div>
          <div><dt>Sitio web</dt><dd data-out="r-sitio"></dd></div>
          <div><dt>Asunto</dt><dd data-out="r-asunto"></dd></div>
          <div><dt>Descripción</dt><dd data-out="r-desc"></dd></div>
        </dl>
        <p class="small muted">Si tienes capturas, envíalas por WhatsApp citando tu número de ticket.</p>
      </section>
      <div class="acciones centradas">
        <button type="button" class="btn btn-primary" data-ir="portada" data-reiniciar>Volver al inicio</button>
        <a class="btn btn-wa" href={WA_AYUDA} data-wa-listo target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_WA}/></svg>Es urgente: escribir por WhatsApp</a>
      </div>
    </div>
  </div>
</Base>

<style>
  [hidden] { display: none !important; }
