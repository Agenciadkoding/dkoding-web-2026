  /* Vista ticket */
  .ticket { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; padding-block: 28px 56px; }
  .lateral { flex: 1 1 260px; max-width: 100%; min-width: 0; display: flex; flex-direction: column; gap: 16px; padding-top: 4px; }
  .sla-lista { list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 15px; }
  .sla-lista li { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--dk-line); }
  .pasos-col { flex: 999 1 680px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .pasos-cab { display: flex; flex-direction: column; gap: 6px; }
  .volver { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0; background: transparent; color: var(--dk-lila-link); border: 0; font-weight: 600; }
  .titulo-vista { font-weight: 300; font-size: clamp(34px, 3.6vw, 48px); line-height: 1.05; }
  .listo .titulo-vista { font-size: clamp(36px, 4.6vw, 58px); }
  .pasos-nav { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 8px; }
  .pasos-nav li { display: flex; }
  .paso-btn { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; padding: 8px 14px; border-radius: var(--r-card); color: var(--dk-text); background: var(--dk-surface); border: 1px solid var(--dk-line); text-align: left; }
  .paso-btn.is-cur { background: var(--dk-deep); border-color: var(--dk-lila); }
  .paso-btn.is-cur .badge { background: var(--dk-violet); color: #fff; border-color: transparent; }
  .paso-btn.is-done .badge { background: rgba(91, 228, 155, 0.14); color: var(--dk-ok); border-color: transparent; }
  .paso-txt { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .paso-val { font-size: 13px; color: var(--dk-muted); }
  .paso-btn.is-done .paso-val { color: var(--dk-soft); }

  .paneles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; align-items: start; }
  .panel { display: flex; flex-direction: column; gap: 14px; min-width: 0; padding: 20px; border-radius: var(--r-card); background: var(--dk-surface); border: 1px solid var(--dk-line); }
  .panel.is-cur { border-color: var(--dk-lila); }
  .panel-h { display: flex; flex-direction: column; gap: 2px; padding-bottom: 14px; border-bottom: 1px solid var(--dk-line); }
  .panel-h h3 { font-size: 24px; }
  @media (max-width: 900px) { .panel:not(.is-cur) { display: none; } }

  .opciones { display: flex; flex-direction: column; gap: 10px; }
  .opcion { display: flex; gap: 12px; align-items: flex-start; width: 100%; min-height: 76px; padding: 14px; border-radius: var(--r-card); color: var(--dk-text); background: #0F0F11; border: 1px solid rgba(255, 255, 255, 0.1); text-align: left; transition: border-color 0.15s ease, background-color 0.15s ease; }
  .opcion:hover { border-color: rgba(199, 85, 239, 0.6); }
  .opcion[aria-pressed="true"] { background: var(--dk-deep); border-color: var(--dk-lila); }
  .opcion svg { flex: none; color: var(--dk-lila); margin-top: 2px; }
  .opcion-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .opcion-txt strong { font-size: 17px; }
  .opcion-desc { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .radio { flex: none; width: 18px; height: 18px; margin-top: 4px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.3); }
  .opcion[aria-pressed="true"] .radio { border: 5px solid var(--dk-lila); background: var(--dk-bg); }
  .servicios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .opcion-sv { flex-direction: column; gap: 8px; min-height: 92px; padding: 12px; }
  .opcion-sv svg { margin: 0; }
  .opcion-sv-txt { font-weight: 600; font-size: 14px; line-height: 1.3; }

  .resumen { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; background: #0F0F11; border: 1px solid var(--dk-line); border-radius: var(--r-card); font-size: 14px; }
  .resumen-fila { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .resumen-k { display: flex; flex-direction: column; min-width: 0; font-size: 12px; color: var(--dk-muted); }
  .resumen-k strong { font-size: 14px; color: var(--dk-text); }
  .resumen-k strong.muted { color: var(--dk-muted); font-weight: 400; }
  .resumen-k strong.falta { color: #FF8F9B; }
  .resumen-fila .btn-link { min-height: 36px; font-size: 14px; }
  .resumen-sla { padding-top: 6px; border-top: 1px solid rgba(255, 255, 255, 0.06); color: var(--dk-muted); }
  .resumen-sla.listo { color: var(--dk-lila-link); }
  .form-ticket { display: flex; flex-direction: column; gap: 14px; }
  .alerta { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; background: rgba(255, 107, 107, 0.08); border: 1px solid rgba(255, 107, 107, 0.4); border-radius: var(--r-card); font-size: 14px; }
  .alerta svg { flex: none; margin-top: 4px; }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .acciones.centradas { justify-content: center; }
  .btn[aria-busy="true"] { opacity: 0.7; pointer-events: none; }

  /* Confirmación */
  .sla-box { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; padding: 20px 22px; background: var(--dk-deep); border: 1px solid rgba(199, 85, 239, 0.55); border-radius: var(--r-card); }
  .sla-main { flex: 1 1 260px; display: flex; flex-direction: column; }
  .sla-box > .small { flex: 1 1 220px; }
  .sla-valor { font-family: var(--font-title); font-weight: 700; font-size: 28px; line-height: 1.15; }
  .resumen-dl { display: flex; flex-direction: column; }
  .resumen-dl > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 16px; padding: 9px 0; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .resumen-dl dt { color: var(--dk-muted); font-size: 15px; }
  .resumen-dl dd { margin: 0; font-weight: 600; text-align: right; overflow-wrap: anywhere; max-width: 100%; }
  @media (max-width: 640px) { .resumen-dl dd { text-align: left; } .listo .titulo-vista { font-size: 34px; } }
</style>

<script>
  import { enviarFormulario, marcarTiempo } from '../scripts/formulario';

  const $ = <T extends HTMLElement>(sel: string, raiz: ParentNode = document) => raiz.querySelector<T>(sel);
  const $$ = <T extends HTMLElement>(sel: string, raiz: ParentNode = document) => Array.from(raiz.querySelectorAll<T>(sel));
  const WA = (texto: string) => `https://api.whatsapp.com/send/?phone=573002867104&text=${encodeURIComponent(texto)}`;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const digitos = (s: string) => s.replace(/\D/g, '');
  const correoOk = (s: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s.trim());

  // ---------- Vistas ----------
  const vistas = $$('[data-vista]');
  function irVista(nombre: string, foco?: string) {
    vistas.forEach((v) => { v.hidden = v.dataset.vista !== nombre; });
    history.replaceState(null, '', nombre === 'ticket' ? '#crear-ticket' : location.pathname);
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    const vista = vistas.find((v) => v.dataset.vista === nombre);
    const h = foco ? document.getElementById(foco) : vista && $<HTMLElement>('h1, .titulo-vista', vista);
    if (h) { if (!h.hasAttribute('tabindex')) h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: !foco }); if (foco) h.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' }); }
  }
  $$('[data-ir]').forEach((b) => b.addEventListener('click', () => {
    if (b.hasAttribute('data-reiniciar')) reiniciarTicket();
    irVista(b.dataset.ir!, b.dataset.foco);
  }));
  if (location.hash === '#crear-ticket') irVista('ticket');

  // ---------- WhatsApp con mensaje ----------
  const waBtns = $$<HTMLAnchorElement>('[data-wa-btn]');
  $$<HTMLInputElement | HTMLTextAreaElement>('[data-wa-texto]').forEach((campo) => campo.addEventListener('input', () => {
    const t = campo.value.trim() || 'Hola, necesito ayuda de DKODING.';
    $$<HTMLInputElement | HTMLTextAreaElement>('[data-wa-texto]').forEach((o) => { if (o !== campo) o.value = campo.value; });
    waBtns.forEach((a) => { a.href = WA(t); });
  }));

  // ---------- Validación de campos ----------
  function marcar(campo: HTMLInputElement | HTMLTextAreaElement, malo: boolean) {
    campo.setAttribute('aria-invalid', String(malo));
    const err = document.getElementById(campo.id + '-err');
    if (err) err.hidden = !malo;
    return !malo;
  }
  function limpiarAlEscribir(form: HTMLFormElement) {
    form.addEventListener('input', (e) => {
      const c = e.target as HTMLInputElement;
      if (c.getAttribute('aria-invalid') === 'true') marcar(c, false);
    });
  }
  function estado(form: HTMLFormElement, texto: string | null, wa?: string) {
    const caja = $<HTMLElement>('[data-estado]', form)!;
    caja.hidden = !texto;
    $<HTMLElement>('[data-estado-txt]', caja)!.textContent = texto ?? '';
    if (wa) $<HTMLAnchorElement>('[data-estado-wa]', caja)!.href = WA(wa);
  }
  function ocupado(form: HTMLFormElement, si: boolean) {
    const b = $<HTMLButtonElement>('[data-enviar]', form)!;
    b.setAttribute('aria-busy', String(si));
    if (si) { b.dataset.html = b.innerHTML; b.textContent = 'Enviando…'; }
    else if (b.dataset.html) b.innerHTML = b.dataset.html;
  }

  // ---------- Solicitar llamada ----------
  const fLlamada = $<HTMLFormElement>('[data-form-llamada]');
  if (fLlamada) {
    marcarTiempo(fLlamada);
    limpiarAlEscribir(fLlamada);
    const okBox = $<HTMLElement>('[data-llamada-ok]')!;
    fLlamada.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nombre = $<HTMLInputElement>('#ll-nombre', fLlamada)!, tel = $<HTMLInputElement>('#ll-tel', fLlamada)!, franja = $<HTMLSelectElement>('#ll-franja', fLlamada)!;
      const ok = [marcar(nombre, !nombre.value.trim()), marcar(tel, digitos(tel.value).length < 7)].every(Boolean);
      if (!ok) { (nombre.getAttribute('aria-invalid') === 'true' ? nombre : tel).focus(); return; }
      estado(fLlamada, null);
      ocupado(fLlamada, true);
      const r = await enviarFormulario(fLlamada, { tipo: 'llamada', detalle: { 'Franja horaria': franja.value } });
      ocupado(fLlamada, false);
      if (!r.ok) { estado(fLlamada, r.error ?? 'No pudimos registrar la llamada.', `Hola DKODING, quiero que me llamen al ${tel.value.trim()}. Soy ${nombre.value.trim()}.`); return; }
      const primer = nombre.value.trim().split(' ')[0];
      $<HTMLElement>('[data-llamada-txt]')!.textContent = `${primer}, te llamaremos al ${tel.value.trim()} en la franja «${franja.value}».${r.numero ? ` Solicitud ${r.numero}.` : ''}`;
      fLlamada.hidden = true; okBox.hidden = false;
    });
    $<HTMLButtonElement>('[data-llamada-otra]')!.addEventListener('click', () => {
      fLlamada.reset(); marcarTiempo(fLlamada); okBox.hidden = true; fLlamada.hidden = false; $<HTMLInputElement>('#ll-nombre', fLlamada)!.focus();
    });
  }

  // ---------- Ticket en 3 pasos ----------
  const fTicket = $<HTMLFormElement>('[data-form-ticket]');
  const est = { tipo: null as HTMLButtonElement | null, servicio: null as HTMLButtonElement | null, paso: 1 };
  const outs = (k: string) => $$<HTMLElement>(`[data-out="${k}"]`);
  const pasoBtns = $$<HTMLButtonElement>('.paso-btn');
  const paneles = $$<HTMLElement>('[data-panel]');

  function pintar() {
    const tipo = est.tipo?.dataset.nombre, svc = est.servicio?.dataset.nombre, sla = est.tipo?.dataset.sla;
    pasoBtns.forEach((b) => {
      const n = Number(b.dataset.paso), cur = n === est.paso, done = (n === 1 && !!tipo) || (n === 2 && !!svc);
      b.classList.toggle('is-cur', cur); b.classList.toggle('is-done', done);
      if (cur) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
      $<HTMLElement>('[data-badge]', b)!.textContent = done ? '✓' : String(n);
    });
    $<HTMLElement>('[data-val="tipo"]')!.textContent = tipo ?? 'sin elegir';
    $<HTMLElement>('[data-val="servicio"]')!.textContent = svc ?? 'sin elegir';
    paneles.forEach((p) => p.classList.toggle('is-cur', Number(p.dataset.panel) === est.paso));
    outs('tipo').forEach((o) => { o.textContent = tipo ?? 'Sin elegir'; o.classList.toggle('muted', !tipo); });
    outs('servicio').forEach((o) => { o.textContent = svc ?? 'Sin elegir'; o.classList.toggle('muted', !svc); });
    const slaTxt = $<HTMLElement>('[data-out="sla-texto"]')!;
    slaTxt.textContent = sla ? `Primera respuesta: ${sla} · compromiso por escrito` : 'El tiempo de primera respuesta depende del tipo de ayuda';
    slaTxt.classList.toggle('listo', !!sla);
    actualizarWaTicket();
  }
  function irPaso(n: number, foco = true) {
    est.paso = n; pintar();
    if (foco) { const p = paneles.find((x) => Number(x.dataset.panel) === n); const h = p && $<HTMLElement>('h3', p); if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); p.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' }); } }
  }
  function elegir(grupo: 'tipo' | 'servicio', btn: HTMLButtonElement) {
    const sel = grupo === 'tipo' ? '[data-tipo]' : '[data-servicio]';
    $$<HTMLButtonElement>(sel).forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    est[grupo] = btn;
    if (grupo === 'tipo') { outs('tipo').forEach((o) => o.classList.remove('falta')); irPaso(est.servicio ? 3 : 2); }
    else { outs('servicio').forEach((o) => o.classList.remove('falta')); irPaso(3); }
  }
  $$<HTMLButtonElement>('[data-tipo]').forEach((b) => b.addEventListener('click', () => elegir('tipo', b)));
  $$<HTMLButtonElement>('[data-servicio]').forEach((b) => b.addEventListener('click', () => elegir('servicio', b)));
  $$<HTMLButtonElement>('[data-paso]').forEach((b) => b.addEventListener('click', () => irPaso(Number(b.dataset.paso))));

  function actualizarWaTicket() {
    if (!fTicket) return;
    const tipo = est.tipo?.dataset.nombre ?? 'soporte', svc = est.servicio?.dataset.nombre ?? '', asunto = $<HTMLInputElement>('#tk-asunto', fTicket)!.value.trim(), sitio = $<HTMLInputElement>('#tk-sitio', fTicket)!.value.trim();
    const partes = [`Hola DKODING, quiero abrir un ticket de ${tipo.toLowerCase()}`, svc && `sobre ${svc.toLowerCase()}`, sitio && `(${sitio})`].filter(Boolean).join(' ');
    $<HTMLAnchorElement>('[data-wa-ticket]')!.href = WA(`${partes}.${asunto ? ` Asunto: ${asunto}.` : ''}`);
  }
  function reiniciarTicket() {
    if (!fTicket) return;
    fTicket.reset(); marcarTiempo(fTicket); estado(fTicket, null);
    $$<HTMLElement>('[aria-invalid="true"]', fTicket).forEach((c) => marcar(c as HTMLInputElement, false));
    $<HTMLElement>('[data-alerta]', fTicket)!.hidden = true;
    $$<HTMLButtonElement>('[data-tipo], [data-servicio]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    est.tipo = null; est.servicio = null; irPaso(1, false);
  }

  if (fTicket) {
    marcarTiempo(fTicket);
    limpiarAlEscribir(fTicket);
    fTicket.addEventListener('input', actualizarWaTicket);
    const alerta = $<HTMLElement>('[data-alerta]', fTicket)!;
    fTicket.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Pasos 1 y 2 antes del formulario.
      if (!est.tipo || !est.servicio) {
        const k = !est.tipo ? 'tipo' : 'servicio';
        outs(k).forEach((o) => { o.textContent = !est.tipo ? 'Elige el tipo de ayuda (paso 1)' : 'Elige el servicio (paso 2)'; o.classList.add('falta'); o.classList.remove('muted'); });
        irPaso(!est.tipo ? 1 : 2);
        return;
      }
      const nombre = $<HTMLInputElement>('#tk-nombre', fTicket)!, correo = $<HTMLInputElement>('#tk-correo', fTicket)!, tel = $<HTMLInputElement>('#tk-tel', fTicket)!;
      const sitio = $<HTMLInputElement>('#tk-sitio', fTicket)!, asunto = $<HTMLInputElement>('#tk-asunto', fTicket)!, desc = $<HTMLTextAreaElement>('#tk-desc', fTicket)!, datos = $<HTMLInputElement>('#tk-datos', fTicket)!;
      const checks = [
        marcar(nombre, !nombre.value.trim()), marcar(correo, !correoOk(correo.value)), marcar(tel, digitos(tel.value).length < 7),
        marcar(asunto, !asunto.value.trim()), marcar(desc, !desc.value.trim()), marcar(datos, !datos.checked),
      ];
      const faltan = checks.filter((c) => !c).length;
      alerta.hidden = faltan === 0;
      if (faltan) {
        $<HTMLElement>('[data-alerta-txt]', alerta)!.textContent = faltan === 1 ? 'Falta 1 dato para enviar el ticket. Está marcado abajo.' : `Faltan ${faltan} datos para enviar el ticket. Están marcados en cada campo.`;
        $<HTMLElement>('[aria-invalid="true"]', fTicket)?.focus();
        return;
      }
      estado(fTicket, null);
      ocupado(fTicket, true);
      const r = await enviarFormulario(fTicket, {
        tipo: 'ticket',
        detalle: { 'Tipo de ayuda': est.tipo.dataset.nombre, Servicio: est.servicio.dataset.nombre, 'Sitio web': sitio.value.trim() || 'no indicado', Asunto: asunto.value.trim(), 'Primera respuesta': est.tipo.dataset.sla },
      });
      ocupado(fTicket, false);
      if (!r.ok) { estado(fTicket, r.error ?? 'No pudimos enviar el ticket.', `Hola DKODING, intenté abrir un ticket de ${est.tipo.dataset.nombre!.toLowerCase()} y no se envió. Asunto: ${asunto.value.trim()}.`); return; }
      // Confirmación
      const numero = r.numero ?? 'registrado';
      const salida: Record<string, string> = {
        numero, correo: correo.value.trim(), sla: est.tipo.dataset.sla!,
        'r-tipo': est.tipo.dataset.nombre!, 'r-servicio': est.servicio.dataset.nombre!, 'r-nombre': nombre.value.trim(), 'r-correo': correo.value.trim(),
        'r-tel': tel.value.trim(), 'r-sitio': sitio.value.trim() || 'no indicado', 'r-asunto': asunto.value.trim(), 'r-desc': desc.value.trim(),
      };
      for (const [k, v] of Object.entries(salida)) outs(k).forEach((o) => { o.textContent = v; });
      $<HTMLAnchorElement>('[data-wa-listo]')!.href = WA(`Hola DKODING, escribo por el ticket ${numero}.`);
      irVista('listo');
    });
    pintar();
  }
</script>
