---
import Base from '../layouts/Base.astro';
import { SITIO, waLink } from '../data/sitio';
import { migasSchema } from '../data/schema';

const ruta = '/nuestro-equipo/';
const wa = waLink('Hola DKODING, quiero hablar con alguien del equipo sobre mi proyecto.');

/** Nombres y cargos entre corchetes: los completa DKODING. Las fotos son reales. */
const equipo = [
  { id: 'ceo', nombre: '[Nombre del CEO]', cargo: 'Director general', sigla: 'CEO', foto: '/img/equipo/dk-equipo-CEO.webp', area: 'Dirección', bio: 'Fundador de DKODING. Dirige la estrategia de cada proyecto y la relación con los clientes. [Dos líneas sobre su experiencia: años, especialidad, lo que más le gusta construir.]', temas: ['Desarrollo web', 'SEO y GEO', 'Software a medida'] },
  { id: 'coo', nombre: '[Nombre del COO]', cargo: 'Director de operaciones', sigla: 'COO', foto: '/img/equipo/dk-equipo-COO.webp', area: 'Operaciones', bio: 'Coordina los equipos de diseño y desarrollo, los plazos y el soporte. [Dos líneas sobre su experiencia y su rol en el panel de agencia.]', temas: ['Proceso y plazos', 'Soporte y monitoreo', 'Diseño de marca'] },
  { id: 'comercial-1', nombre: '[Nombre]', cargo: 'Asesora comercial', sigla: '', foto: '/img/equipo/dk-equipo-comercial-01.webp', area: 'Comercial', bio: 'Atiende a los clientes en Cali, arma las propuestas y acompaña cada proyecto hasta el lanzamiento. [Dos líneas sobre su experiencia.]', temas: ['Cotizaciones', 'Atención en Cali'] },
  { id: 'comercial-2', nombre: '[Nombre]', cargo: 'Asesor comercial', sigla: '', foto: '/img/equipo/dk-equipo-comercial-02.webp', area: 'Comercial', bio: 'Especialista en marketing digital y redes sociales para pymes. [Dos líneas sobre su experiencia.]', temas: ['Marketing digital', 'Redes sociales'] },
  { id: 'comercial-3', nombre: '[Nombre]', cargo: 'Asesor comercial', sigla: '', foto: '/img/equipo/dk-equipo-comercial-03.webp', area: 'Comercial', bio: 'Acompaña a hoteles, clínicas y empresas de servicios en su primer proyecto digital. [Dos líneas sobre su experiencia.]', temas: ['Hoteles y turismo', 'Salud'] },
];

const schema = [
  migasSchema([{ nombre: 'Inicio', url: '/' }, { nombre: 'Nosotros', url: '/nosotros/' }, { nombre: 'Nuestro equipo', url: ruta }]),
  ...equipo.map((e) => ({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITIO.dominio}${ruta}#${e.id}`,
    name: e.nombre,
    jobTitle: e.sigla ? `${e.cargo} (${e.sigla})` : e.cargo,
    image: `${SITIO.dominio}${e.foto}`,
    worksFor: { '@id': `${SITIO.dominio}/#organizacion` },
    knowsAbout: e.temas,
    url: `${SITIO.dominio}${ruta}#${e.id}`,
  })),
];
---
<Base titulo="Nuestro equipo en Cali" descripcion="Conoce al equipo real de DKODING en Cali: dirección, operaciones y asesores comerciales que atienden tu proyecto web, de marca o de marketing. Escríbenos." ruta={ruta} schema={schema}>
  <section class="hero">
    <div class="container">
      <nav class="migas" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">»</span><a href="/nosotros/">Nosotros</a><span aria-hidden="true">»</span><span aria-current="page">Nuestro equipo</span></nav>
      <p class="eyebrow">Nuestro equipo</p>
      <h1>El equipo que <strong>responde tu WhatsApp en Cali</strong></h1>
      <p class="lead">Somos un equipo pequeño en Cali. Quien te cotiza es quien te acompaña hasta el lanzamiento, y quien construye tu sitio es quien lo cuida después. Aquí están las caras, con nombre y cargo, para que sepas con quién hablas.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ul class="personas">
        {equipo.map((e) => (
          <li class="persona card reveal" id={e.id}>
            <img src={e.foto} alt={`Retrato de ${e.nombre}, ${e.cargo.toLowerCase()} de DKODING`} width="768" height="768" loading="lazy">
            <div class="persona-txt">
              <p class="eyebrow">{e.area}</p>
              <h2>{e.nombre}</h2>
              <p class="cargo">{e.cargo}{e.sigla && <span class="pill pill-lila">{e.sigla}</span>}</p>
              <p class="muted">{e.bio}</p>
              <ul class="temas">{e.temas.map((t) => <li class="chip">{t}</li>)}</ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band">
    <div class="container autores">
      <div>
        <p class="eyebrow">Autores del blog</p>
        <h2>Cada artículo lo firma <strong>quien tiene la experiencia</strong></h2>
        <p class="lead">En el blog no hay textos anónimos ni generados en serie. Cada guía la escribe la persona del equipo que hace ese trabajo a diario, con un caso, un dato o un error real. Es lo que hace que una respuesta valga la pena, para una persona y para la IA que la cite.</p>
        <a href="/blog/" class="btn btn-secondary">Ir al blog</a>
      </div>
      <ul class="chev-list autores-list">
        <li><span><strong>{equipo[0].nombre}</strong>, {equipo[0].cargo.toLowerCase()}: desarrollo web, SEO, GEO y software a medida.</span></li>
        <li><span><strong>{equipo[1].nombre}</strong>, {equipo[1].cargo.toLowerCase()}: procesos, soporte, monitoreo y diseño de marca.</span></li>
        <li><span><strong>{equipo[3].nombre}</strong>, {equipo[3].cargo.toLowerCase()}: marketing digital y redes sociales.</span></li>
        <li><span><strong>{equipo[4].nombre}</strong>, {equipo[4].cargo.toLowerCase()}: hoteles, salud y primeros proyectos digitales.</span></li>
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-final band-violet">
        <div class="cta-txt">
          <p class="eyebrow eyebrow-light">Hablemos</p>
          <h2>¿Prefieres hablar con una persona antes de cotizar?</h2>
          <p>Escríbenos por WhatsApp o llámanos en horario laboral. Te atiende alguien de esta página, no un bot.</p>
        </div>
        <div class="cta-btns">
          <a href={wa} class="btn btn-wa btn-lg" rel="noopener">Escribir por WhatsApp</a>
          <a href={SITIO.telefonoHref} class="btn btn-light btn-lg">{SITIO.telefono}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sec-head { max-width: 760px; margin-bottom: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; gap: 14px; }
  .band { background: var(--dk-deep); }
  .hero { padding-block: clamp(32px, 5vw, 72px) clamp(24px, 4vw, 48px); background: radial-gradient(80% 60% at 70% 20%, rgba(109, 0, 194, 0.22), transparent 70%); }
  .hero .container { display: flex; flex-direction: column; gap: 14px; max-width: 900px; margin-inline: 0; }
  .migas { display: flex; gap: 10px; align-items: center; font-size: 14px; color: var(--dk-muted); flex-wrap: wrap; }
  .migas a { color: var(--dk-soft); min-height: 24px; display: inline-flex; align-items: center; }
  .migas span[aria-hidden] { color: var(--dk-lila); font-family: var(--font-title); font-weight: 700; }
  .hero .lead { margin-top: 8px; }

  .personas { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .persona { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 22px; align-items: start; }
  .persona img { width: 160px; height: 160px; border-radius: 50%; object-fit: cover; border: 3px solid var(--dk-deep); }
  .persona-txt { display: flex; flex-direction: column; gap: 8px; }
  .persona h2 { font-size: clamp(24px, 2.2vw, 30px); font-weight: 700; }
  .cargo { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--dk-soft); font-weight: 600; }
  .temas { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .temas .chip { min-height: 34px; font-size: 13px; }

  .autores { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .autores > div { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .autores-list { padding-top: 8px; }

  .cta-final { position: relative; overflow: hidden; border-radius: var(--r-card); padding: clamp(32px, 5vw, 64px); display: grid; grid-template-columns: minmax(0, 1.2fr) auto; gap: 32px; align-items: center; color: #fff; }
  .cta-txt { display: flex; flex-direction: column; gap: 12px; max-width: 60ch; }
  .cta-txt h2 { font-size: clamp(30px, 3.2vw, 44px); }
  .cta-txt p { color: rgba(255, 255, 255, 0.85); }
  .eyebrow-light { color: #E9C8FF; }
  .cta-btns { display: flex; flex-direction: column; gap: 12px; }

  @media (max-width: 1024px) {
    .personas { grid-template-columns: minmax(0, 1fr); }
    .autores, .cta-final { grid-template-columns: minmax(0, 1fr); }
    .cta-btns { flex-direction: row; flex-wrap: wrap; }
  }
  @media (max-width: 640px) {
    .persona { grid-template-columns: minmax(0, 1fr); }
    .persona img { width: 120px; height: 120px; }
    .cta-btns { flex-direction: column; }
  }
</style>
