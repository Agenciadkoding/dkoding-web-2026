  .cz-mdisp-top { display: flex; justify-content: space-between; align-items: center; width: 100%; gap: 8px; }
  .cz-plus { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--dk-ok); color: var(--dk-ok); display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .cz-ocard .cz-i-check { display: none; }
  .cz-ocard[aria-pressed="true"] .cz-plus { background: var(--dk-violet); border-color: var(--dk-violet); color: #fff; }
  .cz-ocard[aria-pressed="true"] .cz-i-plus { display: none; }
  .cz-ocard[aria-pressed="true"] .cz-i-check { display: block; }
  .cz-ocard[aria-pressed="true"] .cz-obadge { background: rgba(199, 85, 239, 0.18); color: var(--dk-lila-link); }
  .cz-dep { font-size: 11px; color: var(--dk-ok); }
  .cz-reco { font-size: 11px; color: var(--dk-lila-link); font-weight: 600; }
  .cz-nota { font-size: 11px; color: var(--dk-warn); }
  .cz-vacio { grid-column: 1 / -1; font-size: 13px; padding: 14px; border: 1px dashed var(--dk-line-2); border-radius: 10px; }

  .cz-msel { display: flex; flex-direction: column; gap: 8px; width: 100%; padding: 14px; border-radius: 10px; background: var(--dk-deep); border: 1px solid rgba(199, 85, 239, 0.45); }
  .cz-msel-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 32px; }
  .cz-inc { font-size: 11px; color: var(--dk-ok); font-weight: 600; margin-left: auto; }
  .cz-opts { display: flex; flex-direction: column; gap: 2px; margin-top: 4px; padding-top: 8px; border-top: 1px dashed var(--dk-line-2); }
  .cz-opts-t { font-size: 11px; color: var(--dk-muted); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px; }
  .cz-opt { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 34px; padding: 2px 0; border: 0; background: transparent; color: var(--dk-text); font-size: 12px; text-align: left; }
  .cz-opt-n { flex: 1; }
  .cz-opt-h { color: var(--dk-lila-link); font-weight: 700; }
  .cz-box { display: inline-flex; width: 14px; height: 14px; border-radius: 3px; flex: none; border: 1px solid rgba(255, 255, 255, 0.35); }
  .cz-opt[aria-pressed="true"] .cz-box { background: var(--dk-violet); border-color: var(--dk-violet); }
  .cz-qty { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 4px; font-size: 12px; color: var(--dk-muted); }
  .cz-qty input { width: 80px; min-height: 40px; padding: 0 8px; border-radius: var(--r-btn); border: 1px solid var(--dk-line-2); background: #0F0F11; color: var(--dk-text); font-size: 13px; }

  /* ===== Ajustes ===== */
  .cz-ajustes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 18px; background: var(--dk-surface); border: 1px solid var(--dk-line-2); border-radius: 10px; }
  .cz-fs { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .cz-fs legend { padding: 0; margin-bottom: 8px; font-size: 12px; color: var(--dk-muted); letter-spacing: 0.06em; text-transform: uppercase; }
  .cz-seg { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 44px; padding: 0 12px; border-radius: 6px; font-size: 13px; text-align: left; background: #0F0F11; color: var(--dk-text); border: 1px solid var(--dk-line-2); }
  .cz-seg[aria-pressed="true"] { background: #24103A; border-color: var(--dk-lila); }
  .cz-seg-f { font-size: 12px; color: var(--dk-muted); flex: none; }

  /* ===== Datos ===== */
  .cz-datos { padding: 22px; background: var(--dk-surface); border: 1px solid var(--dk-line-2); border-radius: 10px; gap: 14px; }
  .cz-form { display: flex; flex-direction: column; gap: 14px; }
  .cz-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .cz-span2 { grid-column: 1 / -1; }
  .cz-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
