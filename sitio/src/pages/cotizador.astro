  .cz-acciones .btn { padding: 0 12px; font-size: 14px; }
  .cz-estado { padding: 12px 14px; border-radius: 6px; background: rgba(91, 228, 155, 0.12); border: 1px solid rgba(91, 228, 155, 0.4); color: var(--dk-text); font-size: 14px; }

  /* ===== Panel ===== */
  .cz-panel { flex: 1 1 340px; max-width: 420px; min-width: 0; position: sticky; top: 84px; display: flex; flex-direction: column; border-radius: 12px; overflow: hidden; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55); border: 1px solid var(--dk-line-2); }
  .cz-panel-top { padding: 20px 22px 16px; background: linear-gradient(160deg, var(--dk-violet), var(--dk-violet-dark)); display: flex; flex-direction: column; gap: 10px; color: #fff; }
  .cz-panel-h { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #EADFF7; font-weight: 600; }
  .cz-aviso { font-size: 12px; color: #FFD58A; }
  .cz-rango { font-family: var(--font-title); font-weight: 700; font-size: 34px; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }
  .cz-rango-nota { font-size: 12px; color: #EADFF7; }
  .cz-mensual { display: flex; justify-content: space-between; gap: 12px; padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, 0.2); font-size: 13px; color: #EADFF7; }
  .cz-mensual strong { font-family: var(--font-title); color: #fff; }
  .cz-cond { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, 0.2); font-size: 11px; color: #EADFF7; }
  .cz-panel-body { background: var(--dk-surface); display: flex; flex-direction: column; gap: 12px; padding: 16px 22px 20px; }
  .cz-fecha { font-size: 13px; }
  .cz-fecha strong { color: var(--dk-lila-link); text-align: right; }
  .cz-desglose { display: flex; flex-direction: column; gap: 10px; }
  .cz-fases { list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: 13px; }
  .cz-fases li { display: flex; flex-direction: column; gap: 4px; }
  .cz-fases strong { color: var(--dk-text); font-weight: 600; }
  .cz-bar { height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.08); overflow: hidden; display: block; }
  .cz-bar-in { display: block; height: 100%; }
  .cz-lineas { list-style: none; display: flex; flex-direction: column; gap: 2px; font-size: 13px; max-height: 240px; overflow: auto; }
  .cz-lineas li { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--dk-line); }
  .cz-l-txt { display: flex; flex-direction: column; min-width: 0; }
  .cz-l-n { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cz-l-k { font-size: 11px; color: var(--dk-muted); }
  .cz-l-v { font-family: var(--font-title); font-weight: 700; white-space: nowrap; }
  .cz-l-ok .cz-l-v { color: var(--dk-ok); }
  .cz-l-lila .cz-l-v { color: var(--dk-lila-link); }
  .cz-l-warn .cz-l-v { color: var(--dk-warn); }
  .cz-confirm { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 12px; background: rgba(224, 169, 59, 0.12); border: 1px solid rgba(224, 169, 59, 0.4); border-radius: 6px; font-size: 12px; }
  .cz-confirm-btns { display: flex; gap: 6px; }
  .cz-texto { border-top: 1px solid var(--dk-line); padding-top: 8px; }
  .cz-texto summary { cursor: pointer; font-size: 12px; color: var(--dk-lila-link); font-weight: 600; min-height: 32px; display: flex; align-items: center; gap: 6px; }
  .cz-texto summary::before { content: '»'; font-family: var(--font-title); font-weight: 700; font-size: 16px; transition: transform 0.15s ease; }
  .cz-texto[open] summary::before { transform: rotate(90deg); }
  .cz-texto pre { margin: 6px 0 0; font: inherit; font-size: 11px; line-height: 1.45; color: var(--dk-soft); white-space: pre-wrap; word-break: break-word; max-height: 220px; overflow: auto; }

  /* ===== Barra móvil y tiquete ===== */
  .cz-barra { display: none; }
  .cz-tiquete { padding: 0; border: 0; background: transparent; color: var(--dk-text); width: 100%; max-width: 100%; height: 100%; max-height: 100%; }
  .cz-tiquete::backdrop { background: rgba(12, 12, 12, 0.9); }
  .cz-tq { position: relative; min-height: 100dvh; background: linear-gradient(180deg, var(--dk-violet-dark) 0%, var(--dk-bg) 55%); display: flex; flex-direction: column; overflow: hidden; font-size: 14px; }
  .cz-tq-deco { position: absolute; right: -30%; top: -6%; width: 70%; height: auto; opacity: 0.3; pointer-events: none; }
  .cz-tq-bar { position: relative; display: flex; justify-content: space-between; align-items: center; padding: 14px 16px 6px; }
  .cz-tq-bar img { height: 20px; width: auto; }
  .cz-tq-close { width: 44px; height: 44px; border-color: rgba(255, 255, 255, 0.3); }
  .cz-tq-sp { width: 44px; }
  .cz-tq-eyebrow { position: relative; margin: 6px 16px 0; text-align: center; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #EADFF7; }
  .cz-tq-paper { position: relative; margin: 14px 20px 0; display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .cz-tq-white { background: var(--dk-text); color: var(--dk-bg); border-radius: 10px 10px 0 0; padding: 18px 18px 8px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .cz-tq-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; color: #5C5968; }
  .cz-tq-title { display: flex; flex-direction: column; gap: 2px; }
  .cz-tq-title strong { font-family: var(--font-title); font-weight: 700; font-size: 20px; line-height: 1.1; }
  .cz-tq-para { font-size: 12px; color: #5C5968; }
  .cz-tq-fecha { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 12px; background: #fff; border: 1px solid rgba(12, 12, 12, 0.08); border-radius: 6px; font-size: 12px; color: #5C5968; }
  .cz-tq-fecha strong { color: var(--dk-violet); text-align: right; }
  .cz-tq-lineas { list-style: none; display: flex; flex-direction: column; font-size: 13px; max-height: 42dvh; overflow: auto; }
  .cz-tq-lineas li { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 0; border-bottom: 1px dashed rgba(12, 12, 12, 0.15); }
  .cz-tq-lineas li:last-child { border-bottom: 0; }
  .cz-tq-lineas .cz-l-txt { display: flex; flex-direction: column; }
  .cz-tq-lineas .cz-l-n { font-weight: 600; white-space: normal; }
  .cz-tq-lineas .cz-l-k { color: #5C5968; }
  .cz-tq-lineas .cz-l-r { display: flex; align-items: center; gap: 10px; flex: none; }
  .cz-tq-lineas .cz-l-v { font-family: var(--font-body); color: var(--dk-bg); }
  .cz-tq-lineas .cz-l-ok .cz-l-v { color: #2F8F5F; }
  .cz-tq-lineas .cz-l-warn .cz-l-v { color: #9A6A10; }
  .cz-tq-lineas .cz-icon-btn { width: 32px; height: 32px; border-color: rgba(12, 12, 12, 0.15); color: #B3261E; margin: 0; }
  .cz-tq-dent { height: 14px; background-image: linear-gradient(45deg, transparent 50%, var(--dk-text) 50%), linear-gradient(-45deg, transparent 50%, var(--dk-text) 50%); background-size: 14px 14px; background-repeat: repeat-x; }
  .cz-tq-total { position: relative; padding: 16px 20px 24px; display: flex; flex-direction: column; gap: 10px; }
  .cz-tq-total-row { align-items: flex-end; }
  .cz-tq-total-txt { display: flex; flex-direction: column; gap: 2px; }
  .cz-tq-h { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dk-muted); }
  .cz-tq-rango { font-family: var(--font-title); font-weight: 700; font-size: 30px; line-height: 1; color: #fff; }
  .cz-tq-total .cz-acciones .btn { min-height: 48px; }
  .cz-tq-total .cz-link { align-self: center; }

  /* ===== FAQ ===== */
  .cz-faq { display: flex; flex-direction: column; gap: 20px; max-width: 880px; }
  .cz-faq h2 { font-size: clamp(28px, 3vw, 40px); }
  .cz-faq-list { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  .cz-faq-item { background: var(--dk-surface); border: 1px solid var(--dk-line); border-radius: var(--r-card); padding: 0 20px; }
  .cz-faq-item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 56px; padding: 12px 0; font-family: var(--font-title); font-weight: 700; font-size: 18px; }
  .cz-faq-item summary::-webkit-details-marker { display: none; }
  .cz-faq-item summary svg { flex: none; transition: transform 0.2s ease; color: var(--dk-lila-link); }
  .cz-faq-item[open] summary svg { transform: rotate(180deg); }
  .cz-faq-item p { padding: 0 0 18px; color: var(--dk-soft); font-size: 16px; line-height: 1.6; }
  .cz-faq-cta { color: var(--dk-muted); }
  .cz-faq-cta a { text-decoration: underline; text-underline-offset: 3px; }

  /* ===== Responsive ===== */
  @media (max-width: 1200px) { .cz-grid4 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .cz-tipos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .cz-panel { display: none; }
    .cz { padding-bottom: 96px; }
    .cz-grid4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cz-tipos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cz-ajustes { grid-template-columns: minmax(0, 1fr); }
    .cz-barra { position: fixed; left: 0; right: 0; bottom: 0; z-index: 46; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(12, 12, 12, 0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid var(--dk-line-2); }
    .cz-barra-txt { display: flex; flex-direction: column; min-width: 0; }
    .cz-barra-h { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dk-muted); }
    .cz-barra-rango { font-family: var(--font-title); font-weight: 700; font-size: 22px; line-height: 1.1; white-space: nowrap; }
    .cz-barra .btn { flex: none; min-height: 44px; }
    body.pag-cotizador .wa-float { display: none; }
  }
  @media (max-width: 640px) {
    .cz-grid4 { grid-template-columns: minmax(0, 1fr); }
    .cz-tipos { grid-template-columns: minmax(0, 1fr); }
    .cz-tipo { min-height: 0; }
    .cz-form-grid { grid-template-columns: minmax(0, 1fr); }
    .cz-acciones { grid-template-columns: minmax(0, 1fr); }
    .cz-stats { width: 100%; }
    .cz-faq-item summary { font-size: 16px; }
  }
  @media (max-width: 420px) { .cz-tq-lineas { max-height: 38dvh; } }
  @media (prefers-reduced-motion: reduce) { .cz-deco { animation: none; } }
</style>

<script>
  import { W, F, OTRAS_FAMILIAS, FAMILIAS, NIVELES, INCLUIDO_H, SETUP_H, type FamiliaId, type GrupoId } from '../data/cotizador';
  import {
    calcular, estadoInicial, normalizarEstado, textoResumen, textoDependencia, fmt, fmtM, fmtFecha,
    type Estado, type Cliente, type Resultado,
  } from '../scripts/cotizador';
  import { enviarFormulario, marcarTiempo } from '../scripts/formulario';
  import { waLink } from '../data/sitio';

  const CLAVE = 'dk-cotizador-v1';
  const root = document.getElementById('cotizador');
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  const dialog = document.getElementById('tiquete') as HTMLDialogElement | null;
  const form = document.getElementById('form-cotizacion') as HTMLFormElement | null;
  if (root && form) iniciar(root, form);

  function iniciar(root: HTMLElement, form: HTMLFormElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let estado: Estado = estadoInicial();
    let cli: Cliente = { nombre: '', empresa: '', tel: '', email: '' };
    let comoNosConocio = '';
    let ultimoFoco: HTMLElement | null = null;
    let r: Resultado = calcular(estado);

    /* ---------- persistencia ---------- */
    try {
      const raw = localStorage.getItem(CLAVE);
      if (raw) {
        const g = JSON.parse(raw) as { estado?: unknown; cli?: Partial<Cliente>; como?: string };
        estado = normalizarEstado(g.estado);
        if (g.cli) cli = { nombre: g.cli.nombre ?? '', empresa: g.cli.empresa ?? '', tel: g.cli.tel ?? '', email: g.cli.email ?? '' };
        comoNosConocio = g.como ?? '';
      }
    } catch { /* sin almacenamiento */ }
    let tGuardar = 0;
    const guardar = () => {
      window.clearTimeout(tGuardar);
      tGuardar = window.setTimeout(() => { try { localStorage.setItem(CLAVE, JSON.stringify({ estado, cli, como: comoNosConocio })); } catch { /* nada */ } }, 150);
    };

    /* ---------- helpers DOM ---------- */
    const q = <T extends Element = HTMLElement>(sel: string, ctx: ParentNode = document) => ctx.querySelector<T>(sel);
    const qa = <T extends Element = HTMLElement>(sel: string, ctx: ParentNode = document) => Array.from(ctx.querySelectorAll<T>(sel));
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const setTxt = (sel: string, v: string) => { for (const el of qa(sel)) el.textContent = v; };
    const setHidden = (el: Element | null, h: boolean) => { if (el) el.toggleAttribute('hidden', h); };

    const campos = {
      nombre: q<HTMLInputElement>('#f-nombre', form)!, empresa: q<HTMLInputElement>('#f-empresa', form)!,
      tel: q<HTMLInputElement>('#f-tel', form)!, email: q<HTMLInputElement>('#f-correo', form)!,
      como: q<HTMLSelectElement>('#f-como', form)!,
    };
    campos.nombre.value = cli.nombre; campos.empresa.value = cli.empresa; campos.tel.value = cli.tel; campos.email.value = cli.email; campos.como.value = comoNosConocio;
    marcarTiempo(form);

    const numCot = () => {
      const hoy = new Date();
      const h = Math.abs((cli.nombre + cli.tel).length * 7919) % 900 + 100;
      return `DK-${hoy.getFullYear()}${String(hoy.getMonth() + 1).padStart(2, '0')}-${h}`;
    };
    const listo = () => cli.nombre.trim().length > 1 && cli.tel.trim().length > 6 && cli.email.indexOf('@') > 0;

    /* ---------- render ---------- */
    function render() {
      r = calcular(estado);
      const texto = textoResumen(estado, r, cli);

      // familias y secciones
      for (const f of FAMILIAS) {
        const on = !!estado.fam[f.id];
        q(`[data-fam="${f.id}"]`)?.setAttribute('aria-pressed', String(on));
        const n = f.id === 'web' ? r.webLines.length : F[f.id as Exclude<FamiliaId, 'web'>].items.filter((it) => estado.otros[it.id]).length;
        const c = q(`[data-fam-count="${f.id}"]`);
        if (c) { c.textContent = String(n); setHidden(c, !(on && n > 0)); }
        setHidden(q(`[data-sec="${f.id}"]`), !on);
      }
      // tipos
      for (const b of qa('[data-tipo]')) b.setAttribute('aria-pressed', String(b.dataset.tipo === estado.tipo));
      // módulos seleccionados
      for (const b of W) {
        const line = r.webLines.find((l) => l.id === b.id);
        const card = q(`.cz-msel[data-id="${b.id}"]`);
        if (card) {
          setHidden(card, !line);
          const inc = !!r.incluidos[b.id];
          const h = q('[data-h]', card); if (h) h.textContent = `+${Math.round(line ? line.h : b.h)} h`;
          setHidden(q('[data-inc]', card), !inc);
          setHidden(q('[data-rm]', card), inc);
          const mine = estado.opts[b.id] ?? {};
          for (const ob of qa('[data-opt-i]', card)) ob.setAttribute('aria-pressed', String(!!mine[ob.dataset.optI ?? '']));
          const qty = q<HTMLInputElement>('[data-qty]', card); if (qty && document.activeElement !== qty) qty.value = String(estado.qtyProd);
          const nota = q('[data-nota]', card);
          if (nota) { const t = (line && line.nota) || (b.ext ? 'Recomendamos herramienta externa integrada. Esta es la versión propia' : ''); nota.textContent = t; setHidden(nota, !t); }
        }
        const disp = q(`.cz-mdisp[data-id="${b.id}"]`);
        if (disp) {
          setHidden(disp, !!r.selected[b.id] || b.g !== estado.grp);
          const dep = q('[data-dep]', disp); const t = textoDependencia(b, r);
          if (dep) { dep.textContent = t; setHidden(dep, !t); }
        }
      }
      setTxt('[data-n-sel]', String(r.webLines.length));
      for (const t of qa('[data-grp]')) t.setAttribute('aria-selected', String(t.dataset.grp === estado.grp));
      setHidden(q('[data-vacio]'), W.some((b) => !r.selected[b.id] && b.g === estado.grp));
      // ajustes
      for (const b of qa<HTMLElement>('[data-seg]')) {
        const k = b.dataset.seg as 'lvl' | 'cont' | 'urg';
        b.setAttribute('aria-pressed', String(estado[k] === b.dataset.v));
      }
      // otras familias
      for (const b of qa('[data-otro]')) b.setAttribute('aria-pressed', String(!!estado.otros[b.dataset.otro ?? '']));

      // panel, barra, tiquete (comparten data-*)
      setTxt('[data-horas]', String(r.totalH));
      setTxt('[data-rango]', r.rangoTxt);
      setTxt('[data-rango-nota]', r.rangoNota);
      setTxt('[data-fecha]', r.fechaTxt);
      setTxt('[data-stat="items"]', String(r.nItems));
      setTxt('[data-stat="horas"]', String(r.totalH));
      setTxt('[data-stat="semanas"]', String(r.semanas));
      setHidden(q('[data-desde]'), !r.modoDesde);
      setHidden(q('[data-tq-desde]'), !r.modoDesde);
      const men = q('[data-mensual]');
      if (men) { setHidden(men, !(r.mensual > 0)); setTxt('[data-ret-n]', String(r.retN)); setTxt('[data-mensual-v]', fmtM(r.mensualNeto)); }
      const tqm = q('[data-tq-mensual]');
      if (tqm) { tqm.textContent = r.mensual > 0 ? `Mensual: ${fmt(r.mensualNeto)} / mes (${r.retN} servicios)` : ''; setHidden(tqm, !(r.mensual > 0)); }
      r.fases.forEach((f, i) => {
        const li = q(`[data-fase="${i}"]`); if (!li) return;
        q('[data-fase-h]', li)!.textContent = String(f.h);
        q('[data-fase-c]', li)!.textContent = f.c;
      });
      const ul = q('[data-lineas]');
      if (ul) ul.innerHTML = r.lineas.map((l) => `<li class="cz-l-${l.tono}"><span class="cz-l-txt"><span class="cz-l-n">${esc(l.n)}</span><span class="cz-l-k">${esc(l.k)}</span></span><span class="cz-l-v">${esc(l.v)}</span></li>`).join('');
      const hint = q('[data-hint]');
      if (hint) hint.textContent = listo() ? `Te enviamos el desglose al correo con el número de cotización ${numCot()}.` : 'WhatsApp funciona ya. Para recibirlo por correo completa nombre, WhatsApp y correo.';
      const pre = q('[data-texto]'); if (pre) pre.textContent = texto;
      const href = waLink(texto);
      for (const a of qa<HTMLAnchorElement>('[data-wa]')) a.href = href;

      renderTiquete();
      guardar();
    }

    function renderTiquete() {
      if (!dialog) return;
      const nivel = NIVELES.find((n) => n.v === estado.lvl);
      setTxt('[data-tq-num]', numCot());
      setTxt('[data-tq-hoy]', fmtFecha(new Date()));
      setTxt('[data-tq-titulo]', r.famWeb ? `${r.tipo.n}${nivel && nivel.f > 1 ? ' · ' + nivel.label.toLowerCase() : ''}` : 'Servicios DKODING');
      setTxt('[data-tq-para]', `${cli.empresa.trim() ? 'Para ' + cli.empresa.trim() + ' · ' : ''}${r.nItems} módulos`);
      const ul = q('[data-tq-lineas]');
      if (!ul) return;
      const items: string[] = [];
      const li = (n: string, k: string, v: string, tono = 'normal', rm = '') =>
        `<li class="cz-l-${tono}"><span class="cz-l-txt"><span class="cz-l-n">${esc(n)}</span>${k ? `<span class="cz-l-k">${esc(k)}</span>` : ''}</span><span class="cz-l-r"><span class="cz-l-v">${esc(v)}</span>${rm ? `<button type="button" class="cz-icon-btn" data-rm="${esc(rm)}" aria-label="Quitar ${esc(n)}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button>` : ''}</span></li>`;
      if (r.famWeb) {
        for (const l of r.webLines) items.push(li(l.n, [l.incluido ? 'Incluido' : 'Añadido', ...l.optsOn.map((o) => o.toLowerCase())].join(' · '), `${Math.round(l.h)} h`, 'normal', l.incluido ? '' : l.id));
        items.push(li('Incluido en todo sitio DKODING', 'Capacitación · soporte 3 meses · dkard', `${INCLUIDO_H} h`, 'ok'));
        items.push(li('Setup técnico y dirección', r.factores.total > 1 ? `+ ajuste ×${r.factores.total.toFixed(2).replace(/0$/, '').replace('.', ',')}` : 'Repo, Cloudflare, analítica, schema', `${Math.round(SETUP_H + r.webDir)} h`));
      }
      for (const l of r.otrosLines) items.push(li(l.n, l.k, l.v, l.ret ? 'lila' : 'normal'));
      for (const l of r.lineas.filter((x) => (x.tono === 'ok' && x.n.startsWith('Descuentos')) || x.tono === 'warn' || x.n.startsWith('Dos o más'))) items.push(li(l.n, l.k, l.v, l.tono));
      ul.innerHTML = items.join('') || '<li><span class="cz-l-txt"><span class="cz-l-n">Elige módulos para ver el resumen</span></span></li>';
    }

    /* ---------- acciones ---------- */
    const toggleFam = (id: FamiliaId) => { estado.fam[id] = !estado.fam[id]; render(); };
    const confirmar = (abrir: boolean) => { for (const c of qa('[data-confirm]')) setHidden(c, !abrir); for (const b of qa('[data-act="vaciar"]')) setHidden(b, abrir); };
    const vaciar = () => {
      estado = estadoInicial();
      try { localStorage.removeItem(CLAVE); } catch { /* nada */ }
      confirmar(false);
      render();
    };
    const abrirTiquete = (origen: HTMLElement) => {
      if (!dialog) return;
      ultimoFoco = origen;
      renderTiquete();
      if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open', '');
      document.documentElement.style.overflow = 'hidden';
      q<HTMLElement>('[data-act="cerrar-tiquete"]', dialog)?.focus();
    };
    const cerrarTiquete = () => {
      if (!dialog) return;
      if (dialog.open) dialog.close(); else dialog.removeAttribute('open');
      document.documentElement.style.overflow = '';
      ultimoFoco?.focus();
    };
    dialog?.addEventListener('close', () => { document.documentElement.style.overflow = ''; ultimoFoco?.focus(); });
    dialog?.addEventListener('cancel', (e) => { e.preventDefault(); cerrarTiquete(); });

    function onClick(e: Event) {
      const t = (e.target as HTMLElement).closest<HTMLElement>('button, [data-act]');
      if (!t) return;
      const d = t.dataset;
      if (d.fam) return toggleFam(d.fam as FamiliaId);
      if (d.tipo) { estado.tipo = d.tipo; return render(); }
      if (d.grp) { estado.grp = d.grp as GrupoId; return render(); }
      if (d.rm) { delete estado.sel[d.rm]; delete estado.opts[d.rm]; return render(); }
      if (t.classList.contains('cz-mdisp') && d.id) { estado.sel[d.id] = true; return render(); }
      if (d.optMod !== undefined && d.optI !== undefined) {
        const mine = estado.opts[d.optMod] ?? {}; mine[d.optI] = !mine[d.optI]; estado.opts[d.optMod] = mine; return render();
      }
      if (d.seg && d.v) { (estado as unknown as Record<string, string>)[d.seg] = d.v; return render(); }
      if (d.otro) { estado.otros[d.otro] = !estado.otros[d.otro]; return render(); }
      switch (d.act) {
        case 'quitar-anadidos': estado.sel = {}; estado.opts = {}; return render();
        case 'desglose': { const open = t.getAttribute('aria-expanded') === 'true'; t.setAttribute('aria-expanded', String(!open)); setHidden(q('#desglose'), open); return; }
        case 'vaciar': return confirmar(true);
        case 'vaciar-no': return confirmar(false);
        case 'vaciar-si': return vaciar();
        case 'abrir-tiquete': return abrirTiquete(t);
        case 'cerrar-tiquete': return cerrarTiquete();
        case 'ir-datos': {
          cerrarTiquete();
          document.getElementById('datos')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          window.setTimeout(() => campos.nombre.focus({ preventScroll: true }), reduce ? 0 : 450);
          return;
        }
      }
    }
    root.addEventListener('click', onClick);
    barra?.addEventListener('click', onClick);
    dialog?.addEventListener('click', (e) => { if (e.target === dialog) cerrarTiquete(); else onClick(e); });

    root.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement | HTMLSelectElement;
      if (t.matches('[data-qty]')) { estado.qtyProd = Math.max(0, Number(t.value) || 0); return render(); }
      if (t === campos.nombre) cli.nombre = t.value;
      else if (t === campos.empresa) cli.empresa = t.value;
      else if (t === campos.tel) cli.tel = t.value;
      else if (t === campos.email) cli.email = t.value;
      else if (t === campos.como) comoNosConocio = t.value;
      else return;
      render();
    });

    /* ---------- envío por correo ---------- */
    const errorEl = q('[data-form-error]', form)!;
    const okEl = q('[data-form-ok]', form)!;
    const btn = q<HTMLButtonElement>('[data-submit]', form)!;
    const btnTxt = q('[data-submit-txt]', form)!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setHidden(errorEl, true); setHidden(okEl, true);
      for (const el of [campos.nombre, campos.tel, campos.email]) el.removeAttribute('aria-invalid');
      if (!form.checkValidity() || !listo()) {
        const malo = [campos.nombre, campos.tel, campos.email].find((el) => !el.checkValidity() || !el.value.trim()) ?? campos.nombre;
        malo.setAttribute('aria-invalid', 'true');
        errorEl.textContent = 'Completa nombre, WhatsApp y correo para enviarte el detalle.';
        setHidden(errorEl, false);
        document.getElementById('datos')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        malo.focus({ preventScroll: true });
        return;
      }
      if (r.totalH === 0) {
        errorEl.textContent = 'Elige al menos un módulo o servicio antes de enviar.'; setHidden(errorEl, false); return;
      }
      btn.disabled = true; btnTxt.textContent = 'Enviando…';
      const texto = textoResumen(estado, r, cli);
      const res = await enviarFormulario(form, {
        tipo: 'cotizacion',
        comoNosConocio,
        detalle: {
          numero: numCot(),
          resumen: texto,
          lineas: r.lineas.map((l) => `${l.n} · ${l.k} · ${l.v}`),
          modulos: r.webLines.map((l) => `${l.n} · ${Math.round(l.h)} h${l.optsOn.length ? ' (' + l.optsOn.join(', ') + ')' : ''}`),
          otros: r.otrosLines.map((l) => `${l.n} · ${l.k} · ${l.v}`),
          rango: { min: r.minV, max: r.maxV, texto: r.rangoTxt, modoDesde: r.modoDesde },
          horas: r.totalH,
          mensual: r.mensualNeto,
          entrega: r.fechaTxt,
          tipo: r.tipo.n, nivel: estado.lvl, contenido: estado.cont, tiempos: estado.urg,
        },
      });
      btn.disabled = false; btnTxt.textContent = 'Enviar al correo';
      if (res.ok) {
        okEl.textContent = `Listo. Te enviamos la cotización${res.numero ? ' n.º ' + res.numero : ''} a ${cli.email.trim()}. Te escribimos en menos de un día hábil.`;
        setHidden(okEl, false);
        okEl.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
      } else {
        errorEl.innerHTML = `${esc(res.error || 'No pudimos enviar el correo.')} <a href="${waLink(texto)}" target="_blank" rel="noopener">Envíalo por WhatsApp</a>.`;
        setHidden(errorEl, false);
      }
    });

    render();
  }
</script>
