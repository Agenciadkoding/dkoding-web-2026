---
/**
 * /casos-de-exito/ · 4 destacados + galería de sitios en vivo con captura de página completa.
 * Portado de diseno/admin/Casos.dc.html. Datos: src/data/casos.json (se excluyen los sitios con `nota`
 * de verificación). Las dimensiones de cada captura se leen en build con sharp.
 */
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';
import Base from '../layouts/Base.astro';
import { SITIO, waLink } from '../data/sitio';
import { migasSchema } from '../data/schema';
import casos from '../data/casos.json';

const PUB = fileURLToPath(new URL('../../public/img/', import.meta.url));
async function dims(rel: string, porDefecto = { w: 550, h: 2000 }) {
  try { const m = await sharp(path.join(PUB, rel)).metadata(); return { w: m.width ?? porDefecto.w, h: m.height ?? porDefecto.h }; }
  catch { return porDefecto; }
}
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
/** Duración del recorrido: ~4 s por cada 2.000 px de captura (a 550 px de ancho), entre 2,5 y 6 s. */
const duracion = (w: number, h: number) => Math.round(Math.max(2.5, Math.min(6, (4 * (h * 550 / w)) / 2000)) * 10) / 10;

const ORDEN = ['Hoteles y turismo', 'Salud y bienestar', 'Industria', 'Tecnología y software', 'Servicios', 'Comercio', 'Alimentos', 'Educación', 'Servicios legales'];
const vivos = casos.sitios.filter((s) => !('nota' in s && s.nota));
const conteo: Record<string, number> = {};
for (const s of vivos) conteo[s.sector] = (conteo[s.sector] ?? 0) + 1;
const sectores = Object.keys(conteo).sort((a, b) => (ORDEN.indexOf(a) + 1 || 99) - (ORDEN.indexOf(b) + 1 || 99));
const pequenos = sectores.filter((s) => conteo[s] <= 2);
const grupoDe = (sector: string) => (pequenos.includes(sector) ? 'otros' : slug(sector));
const filtros = [
  { id: 'todos', nombre: 'Todos', n: vivos.length, title: '' },
  ...sectores.filter((s) => conteo[s] > 2).map((s) => ({ id: slug(s), nombre: s, n: conteo[s], title: '' })),
  ...(pequenos.length ? [{ id: 'otros', nombre: 'Otros', n: pequenos.reduce((a, s) => a + conteo[s], 0), title: pequenos.join(', ') }] : []),
];

const sitios = await Promise.all(vivos.map(async (s) => {
  const archivo = path.basename(s.captura);
  const { w, h } = await dims(`casos/${archivo}`);
  return { ...s, id: slug(s.nombre), src: `/img/casos/${archivo}`, w, h, dur: duracion(w, h), grupo: grupoDe(s.sector), meta: s.sector + (s.pais ? ` · ${s.pais}` : '') };
}));
const paises = [...new Set(vivos.map((s) => s.pais).filter(Boolean))];

const IMG_DESTACADO: Record<string, string> = { '4bell': 'casos-destacado-4bellu-min-3.jpg', colorado: 'experiencia-colorado.jpg', jhoana: 'experiencia-jhoana.jpg', luzma: 'experiencia-luzma.jpg' };
const destacados = await Promise.all(casos.destacados.map(async (d, i) => {
  const clave = Object.keys(IMG_DESTACADO).find((k) => slug(d.nombre).startsWith(k)) ?? 'jhoana';
  const archivo = IMG_DESTACADO[clave];
  const { w, h } = await dims(`destacados/${archivo}`, { w: 1100, h: 1100 });
  const etiquetas = d.servicios.split(/ y /).map((t) => t.trim().charAt(0).toUpperCase() + t.trim().slice(1));
  return { ...d, i, id: `destacado-${slug(d.nombre)}`, src: `/img/destacados/${archivo}`, w, h, etiquetas };
}));

const WA_CASOS = waLink('Hola DKODING, quiero un sitio como los de sus casos de éxito.');
const ICONO_WA = 'M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z';
const schema = [
  migasSchema([{ nombre: 'Inicio', url: '/' }, { nombre: 'Casos de éxito', url: '/casos-de-exito/' }]),
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'Sitios web hechos por DKODING', numberOfItems: sitios.length,
    itemListElement: sitios.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.nombre, url: s.url })),
  },
];
---
<Base
  titulo="Casos de éxito: sitios web y marcas"
  descripcion={`${sitios.length} sitios web en vivo y 4 proyectos de marca, SEO y tienda virtual hechos por DKODING en Medellín. Recorre cada página completa.`}
  ruta="/casos-de-exito/"
  schema={schema}
>
  <!-- ===== 1 · HERO ===== -->
  <section class="hero" aria-labelledby="h-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-in">
      <p class="eyebrow">Casos de éxito</p>
      <h1 id="h-hero">Casos de éxito: <strong>páginas web</strong> que hicimos en Medellín y fuera</h1>
      <p class="lead">Estos son sitios reales, en vivo, diseñados y publicados por DKODING para empresas de Medellín, del resto de Colombia y de otros países. Pasa el cursor por cada captura para recorrer la página completa, ábrela en grande con «Ver completa» o visita el sitio. Arriba verás cuatro proyectos destacados que van de la marca al sitio que vende.</p>
      <dl class="cifras">
        <div><dd class="cifra">{sitios.length}</dd><dt>sitios en vivo</dt><span class="small muted">hechos y publicados por DKODING</span></div>
        <div><dd class="cifra">{paises.length}</dd><dt>{paises.length === 1 ? 'país' : 'países'}</dt><span class="small muted">{paises.join(', ').replace(/, ([^,]*)$/, ' y $1')}</span></div>
        <div><dd class="cifra">{destacados.length}</dd><dt>casos destacados</dt><span class="small muted">de la marca al sitio que vende</span></div>
      </dl>
    </div>
  </section>

  <!-- ===== 2 · DESTACADOS ===== -->
  <section class="container section-tight destacados" aria-labelledby="h-dest">
    <div class="cab">
      <p class="eyebrow">Destacados</p>
      <h2 id="h-dest">Cuatro proyectos, <strong>de la marca a la venta</strong></h2>
    </div>
    <div class="dest-grid">
      {destacados.map((d) => (
        <article class="dest" aria-labelledby={d.id}>
          <a class="dest-img" href={d.url} target="_blank" rel="noopener" aria-label={`${d.nombre}: visitar el sitio (abre en otra pestaña)`}>
            <img src={d.src} alt={`Proyecto ${d.nombre}: ${d.servicios.toLowerCase()}`} width={d.w} height={d.h} loading={d.i === 0 ? 'eager' : 'lazy'} decoding="async">
          </a>
          <div class="dest-body">
            <h3 id={d.id}>{d.nombre}</h3>
            <ul class="tags" aria-label="Servicios">{d.etiquetas.map((t) => <li class="pill pill-lila">{t}</li>)}</ul>
            <p class="soft">{d.texto}</p>
            <a class="ext" href={d.url} target="_blank" rel="noopener">Visitar sitio<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg><span class="visually-hidden">(abre en otra pestaña)</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===== 3 · GALERÍA DE SITIOS EN VIVO ===== -->
  <section class="galeria" aria-labelledby="h-gal">
    <div class="container section-tight galeria-in">
      <div class="gal-cab">
        <div class="cab">
          <p class="eyebrow">Galería</p>
          <h2 id="h-gal">Sitios <strong>en vivo</strong></h2>
        </div>
        <p class="muted" role="status" data-conteo>Mostrando {sitios.length} de {sitios.length} sitios</p>
      </div>
      <div class="filtros" role="group" aria-label="Filtrar por sector">
        {filtros.map((f) => <button type="button" class="filtro" data-filtro={f.id} aria-pressed={f.id === 'todos' ? 'true' : 'false'} title={f.title || undefined}>{f.nombre}<span class="n">{f.n}</span></button>)}
      </div>
      <div class="gal-grid">
        {sitios.map((s) => (
          <article class="caso" aria-labelledby={`sitio-${s.id}`} data-grupo={s.grupo}>
            <a class="marco" href={s.url} target="_blank" rel="noopener" aria-label={`${s.nombre}: visitar el sitio (abre en otra pestaña)`} style={`--dur: ${s.dur}s`}>
              <img src={s.src} alt={`Página de inicio completa de ${s.nombre}`} width={s.w} height={s.h} loading="lazy" decoding="async">
              <span class="pista" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v16"/><path d="M8 8l4-4 4 4"/><path d="M8 16l4 4 4-4"/></svg></span>
            </a>
            <div class="caso-body">
              <div>
                <h3 id={`sitio-${s.id}`}>{s.nombre}</h3>
                <p class="small muted">{s.meta}</p>
              </div>
              <div class="caso-acc">
                <button type="button" class="btn btn-secondary btn-sm" data-ver data-src={s.src} data-w={s.w} data-h={s.h} data-nombre={s.nombre} data-meta={s.meta} data-url={s.url} aria-label={`Ver completa la captura de ${s.nombre}`}>Ver completa</button>
                <a class="ext" href={s.url} target="_blank" rel="noopener">Visitar sitio<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg><span class="visually-hidden">(abre en otra pestaña)</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 4 · CTA FINAL ===== -->
  <section class="container section-tight" aria-labelledby="h-cta">
    <div class="cta">
      <svg aria-hidden="true" class="cta-deco" width="320" height="240" viewBox="0 0 26 20" fill="none" stroke="var(--dk-lila)" stroke-width="2.4" stroke-linecap="square"><path d="M2 2l8 8-8 8M12 2l8 8-8 8"/></svg>
      <div class="cta-txt">
        <h2 id="h-cta">¿Quieres el <strong>tuyo aquí?</strong></h2>
        <p class="lead soft">Cuéntanos qué vendes y te mostramos cómo se vería. Cotización en minutos, sin compromiso. Conoce también nuestro servicio de <a href="/">diseño de páginas web en Medellín</a>.</p>
      </div>
      <div class="cta-btns">
        <a class="btn btn-primary btn-lg" href="/cotizador/">Cotizar mi proyecto<span class="chev" aria-hidden="true">»</span></a>
        <a class="btn btn-wa btn-lg" href={WA_CASOS} target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_WA}/></svg>WhatsApp {SITIO.telefono}</a>
      </div>
    </div>
  </section>

  <!-- ===== MODAL: captura completa ===== -->
  <dialog class="modal" data-modal aria-labelledby="h-modal">
    <div class="modal-cab">
      <div class="modal-tit"><h2 id="h-modal" data-m="nombre">Captura completa</h2><span class="small muted" data-m="meta"></span></div>
      <div class="modal-acc">
        <a class="btn btn-secondary btn-sm" href="#" target="_blank" rel="noopener" data-m="url">Visitar sitio</a>
        <button type="button" class="cerrar" data-cerrar aria-label="Cerrar"><span aria-hidden="true">×</span></button>
      </div>
    </div>
    <div class="modal-scroll" tabindex="0" aria-label="Captura completa, desplázate para recorrerla">
      <img src="" alt="" width="550" height="2000" data-m="img">
    </div>
  </dialog>
</Base>

<style>
  .small { font-size: 14px; }
  .chev { font-family: var(--font-title); font-weight: 700; font-size: 18px; }
  .cab { display: flex; flex-direction: column; gap: 6px; }

  /* Hero */
  .hero { position: relative; }
  .glow { position: absolute; inset: 0; background: radial-gradient(55% 80% at 50% 0%, rgba(109, 0, 194, 0.28), rgba(109, 0, 194, 0) 70%); pointer-events: none; }
  .hero-in { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; padding-block: clamp(48px, 6vw, 72px) clamp(32px, 4vw, 48px); }
  .hero h1 { max-width: 1000px; font-size: clamp(36px, 4.6vw, 66px); }
  .hero .lead { text-align: center; }
  .cifras { margin-top: 12px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 12px; width: 100%; max-width: 820px; }
  .cifras > div { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 16px 12px; background: rgba(21, 21, 24, 0.75); border: 1px solid var(--dk-line); border-radius: var(--r-card); }
  .cifras dd { margin: 0; font-size: 40px; }
  .cifras dt { font-weight: 600; }

  /* Destacados */
  .destacados { display: flex; flex-direction: column; gap: 24px; }
  .dest-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr)); gap: 24px; }
  .dest { display: grid; grid-template-columns: 240px minmax(0, 1fr); min-width: 0; background: var(--dk-surface); border: 1px solid var(--dk-line); border-radius: var(--r-card); overflow: hidden; }
  .dest-img { display: block; background: var(--dk-deep); border-right: 1px solid var(--dk-line); }
  .dest-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .dest-img:hover img, .dest-img:focus-visible img { transform: scale(1.03); }
  .dest-img:focus-visible { outline-offset: -3px; }
  .dest-body { display: flex; flex-direction: column; gap: 12px; padding: 22px 24px 24px; min-width: 0; }
  .dest-body h3 { font-size: 26px; }
  .dest-body p { font-size: 16px; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .ext { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--dk-text); font-weight: 600; margin-top: auto; }
  .ext:hover { color: var(--dk-lila-link); }
  @media (max-width: 720px) {
    .dest { grid-template-columns: minmax(0, 1fr); }
    .dest-img { aspect-ratio: 16 / 10; border-right: 0; border-bottom: 1px solid var(--dk-line); }
  }

  /* Galería */
  .galeria { background: #0F0F11; border-top: 1px solid rgba(255, 255, 255, 0.06); border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
  .galeria-in { display: flex; flex-direction: column; gap: 24px; }
  .gal-cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 24px; }
  .filtros { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtro { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: var(--r-pill); font-weight: 600; background: transparent; color: var(--dk-soft); border: 1px solid var(--dk-line-2); transition: border-color 0.15s ease, background-color 0.15s ease; }
  .filtro:hover { border-color: var(--dk-lila-link); color: var(--dk-text); }
  .filtro[aria-pressed="true"] { background: var(--dk-deep); color: var(--dk-text); border-color: var(--dk-lila); }
  .filtro .n { font-variant-numeric: tabular-nums; opacity: 0.75; font-weight: 500; }
  .gal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 24px; }
  .caso { display: flex; flex-direction: column; min-width: 0; background: var(--dk-surface); border: 1px solid var(--dk-line); border-radius: var(--r-card); overflow: hidden; }
  [hidden] { display: none !important; }

  /* Marco con la captura completa: recorre de arriba a abajo al pasar el cursor o enfocar. */
  .marco { --dur: 4s; position: relative; display: block; height: 420px; overflow: hidden; background: #0F0F11; border-bottom: 1px solid var(--dk-line); }
  .marco img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; transition: object-position var(--dur) ease-in-out; }
  .marco:hover img, .marco:focus-visible img { object-position: 50% 100%; }
  .marco:focus-visible { outline-offset: -2px; }
  .pista { position: absolute; right: 10px; top: 10px; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(12, 12, 12, 0.78); color: var(--dk-text); transition: opacity 0.3s; }
  .marco:hover .pista, .marco:focus-visible .pista { opacity: 0; }
  @media (max-width: 640px) { .marco { height: 250px; } .pista { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .marco img { transition: none; }
    .marco:hover img, .marco:focus-visible img { object-position: 50% 0%; }
  }
  .caso-body { display: flex; flex-direction: column; gap: 10px; padding: 16px 18px 18px; }
  .caso-body h3 { font-size: 22px; line-height: 1.15; }
  .caso-acc { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
  .caso-acc .btn-sm { min-height: 44px; }
  .caso-acc .ext { margin: 0; }

  /* CTA */
  .cta { position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; padding: clamp(24px, 3.5vw, 40px); background: var(--dk-deep); border: 1px solid rgba(199, 85, 239, 0.55); border-radius: var(--r-card); }
  .cta-deco { position: absolute; right: -40px; top: -30px; opacity: 0.12; pointer-events: none; }
  .cta-txt { position: relative; flex: 1 1 380px; display: flex; flex-direction: column; gap: 10px; }
  .cta-txt h2 { font-size: clamp(32px, 3.6vw, 52px); }
  .cta-txt a { text-decoration: underline; text-underline-offset: 3px; }
  .cta-btns { position: relative; display: flex; flex-wrap: wrap; gap: 12px; }

  /* Modal */
  .modal { width: 680px; max-width: calc(100vw - 32px); max-height: calc(100vh - 32px); padding: 0; margin: auto; border: 1px solid var(--dk-line-2); border-radius: var(--r-card); background: var(--dk-surface); color: var(--dk-text); overflow: hidden; display: none; flex-direction: column; }
  .modal[open] { display: flex; }
  .modal::backdrop { background: rgba(0, 0, 0, 0.75); }
  .modal-cab { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding: 12px 12px 12px 20px; border-bottom: 1px solid var(--dk-line); }
  .modal-tit { display: flex; flex-direction: column; min-width: 0; }
  .modal-tit h2 { font-weight: 700; font-size: 22px; line-height: 1.15; }
  .modal-acc { display: flex; align-items: center; gap: 8px; }
  .modal-acc .btn-sm { min-height: 44px; }
  .cerrar { width: 44px; height: 44px; background: transparent; color: var(--dk-text); border: 1px solid var(--dk-line-3); border-radius: var(--r-btn); font-size: 24px; line-height: 1; }
  .cerrar:hover { border-color: var(--dk-text); }
  .modal-scroll { overflow-y: auto; background: var(--dk-bg); flex: 1 1 auto; min-height: 0; }
  .modal-scroll img { width: 100%; max-width: 550px; margin: 0 auto; }
</style>

<script>
  // Filtro por sector sin recarga.
  const tarjetas = Array.from(document.querySelectorAll<HTMLElement>('.caso'));
  const filtros = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
  const conteo = document.querySelector<HTMLElement>('[data-conteo]');
  filtros.forEach((b) => b.addEventListener('click', () => {
    const id = b.dataset.filtro!;
    filtros.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    let n = 0;
    tarjetas.forEach((t) => { const ver = id === 'todos' || t.dataset.grupo === id; t.hidden = !ver; if (ver) n++; });
    if (conteo) conteo.textContent = `Mostrando ${n} de ${tarjetas.length}${id === 'todos' ? ' sitios' : ` · ${id === 'otros' ? 'otros sectores' : b.firstChild?.textContent?.toLowerCase()}`}`;
  }));

  // Modal con la captura completa.
  const modal = document.querySelector<HTMLDialogElement>('[data-modal]');
  if (modal && typeof modal.showModal === 'function') {
    const img = modal.querySelector<HTMLImageElement>('[data-m="img"]')!;
    const nombre = modal.querySelector<HTMLElement>('[data-m="nombre"]')!;
    const meta = modal.querySelector<HTMLElement>('[data-m="meta"]')!;
    const url = modal.querySelector<HTMLAnchorElement>('[data-m="url"]')!;
    const scroll = modal.querySelector<HTMLElement>('.modal-scroll')!;
    let origen: HTMLElement | null = null;
    document.querySelectorAll<HTMLButtonElement>('[data-ver]').forEach((b) => b.addEventListener('click', () => {
      origen = b;
      img.src = b.dataset.src!; img.width = Number(b.dataset.w); img.height = Number(b.dataset.h);
      img.alt = `Página de inicio completa de ${b.dataset.nombre}`;
      nombre.textContent = b.dataset.nombre ?? ''; meta.textContent = b.dataset.meta ?? ''; url.href = b.dataset.url ?? '#';
      scroll.scrollTop = 0;
      modal.showModal();
      modal.querySelector<HTMLButtonElement>('[data-cerrar]')?.focus();
    }));
    modal.querySelector('[data-cerrar]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
    modal.addEventListener('close', () => { origen?.focus(); });
  } else {
    // Sin <dialog>: «Ver completa» abre la captura en otra pestaña.
    document.querySelectorAll<HTMLButtonElement>('[data-ver]').forEach((b) => b.addEventListener('click', () => window.open(b.dataset.src, '_blank', 'noopener')));
  }
</script>
