---
/**
 * Plantilla base: <head> con SEO y schema, cabecera, pie y botón flotante de WhatsApp.
 * Cada página pasa título, descripción y, si aplica, schema (JSON-LD) e imagen OG.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import { SITIO } from '../data/sitio';
import { organizacionSchema } from '../data/schema';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica relativa, con barra final. Por defecto, la de la página. */
  ruta?: string;
  ogImage?: string;
  ogTipo?: 'website' | 'article';
  /** Objetos JSON-LD adicionales (Service, FAQPage, Article, BreadcrumbList…). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Oculta cabecera y pie (páginas de utilidad). */
  sinMarco?: boolean;
  /** Clase para el <body>. */
  bodyClass?: string;
  publicado?: string;
  modificado?: string;
}

const {
  titulo, descripcion, ruta, ogImage = '/img/og/dkoding.png', ogTipo = 'website',
  schema = [], noindex = false, sinMarco = false, bodyClass = '', publicado, modificado,
} = Astro.props;

const canonical = new URL(ruta ?? Astro.url.pathname, SITIO.dominio).href;
const og = new URL(ogImage, SITIO.dominio).href;
const tituloCompleto = titulo.includes('DKODING') ? titulo : `${titulo} | DKODING`;
const jsonld = [organizacionSchema(), ...schema];
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8">
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <meta name="theme-color" content="#0C0C0C">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/img/marca/isotipo.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/marca/isotipo.png">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href="/fuentes/blinker-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fuentes/barlow-400.woff2" as="font" type="font/woff2" crossorigin>
  <meta property="og:type" content={ogTipo}>
  <meta property="og:site_name" content="DKODING">
  <meta property="og:locale" content="es_CO">
  <meta property="og:title" content={tituloCompleto}>
  <meta property="og:description" content={descripcion}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={og}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  {publicado && <meta property="article:published_time" content={publicado}>}
  {modificado && <meta property="article:modified_time" content={modificado}>}
  {jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  <slot name="head" />
</head>
<body class={bodyClass}>
  <a href="#contenido" class="skip">Saltar al contenido</a>
  {!sinMarco && <Header />}
  <main id="contenido">
    <slot />
  </main>
  {!sinMarco && <Footer />}
  {!sinMarco && <WhatsAppFlotante />}
  <script>
    // Revelado al entrar en pantalla, con respeto a prefers-reduced-motion.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>

<style is:global>
  .skip { position: absolute; left: 16px; top: -60px; z-index: 100; padding: 10px 14px; background: var(--dk-violet); color: #fff; border-radius: 4px; font-weight: 600; }
  .skip:focus { top: 12px; }
</style>
