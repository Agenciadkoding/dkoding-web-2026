---
/**
 * Marco común de las páginas legales: aviso de revisión, migas, título, fecha de
 * actualización, índice de secciones y cuerpo .prose desde la colección `legales`.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fechaLarga, fechaISO } from '../data/blog';
import { migasSchema } from '../data/schema';
import { SITIO } from '../data/sitio';

interface Props { entry: CollectionEntry<'legales'>; ruta: string; }
const { entry, ruta } = Astro.props;
const { Content, headings } = await render(entry);
const secciones = headings.filter((h) => h.depth === 2);
const d = entry.data;
const schema = [migasSchema([{ nombre: 'Inicio', url: '/' }, { nombre: d.titulo, url: ruta }])];
const legales = [
  { url: '/terminos/', nombre: 'Términos y condiciones' },
  { url: '/politica-de-privacidad/', nombre: 'Política de datos personales' },
  { url: '/cookies/', nombre: 'Política de cookies' },
].filter((l) => l.url !== ruta);
---
<Base titulo={d.titulo} descripcion={d.descripcion} ruta={ruta} schema={schema} modificado={d.actualizado.toISOString()}>
  <section class="section-tight cabecera">
    <div class="container">
      <p class="pill pill-warn aviso">Versión en revisión legal</p>
      <nav class="migas" aria-label="Migas de pan">
        <ol><li><a href="/">Inicio</a></li><li aria-current="page">{d.titulo}</li></ol>
      </nav>
      <p class="eyebrow">Legal</p>
      <h1>{d.titulo}</h1>
      <p class="muted fecha">
        Última actualización: <time datetime={fechaISO(d.actualizado)}>{fechaLarga(d.actualizado)}</time>
        {d.version && <span> · Versión {d.version}</span>}
      </p>
    </div>
  </section>

  <div class="container cuerpo">
    <nav class="indice card" aria-labelledby="indice-titulo">
      <p id="indice-titulo" class="indice-titulo">Contenido</p>
      <ol>
        {secciones.map((s) => <li><a href={`#${s.slug}`}>{s.text}</a></li>)}
      </ol>
    </nav>

    <div class="texto">
      <div class="prose legal">
        <Content />
      </div>
      <div class="otros card">
        <p class="otros-titulo">Otros documentos</p>
        <ul class="chev-list">
          {legales.map((l) => <li><a href={l.url}>{l.nombre}</a></li>)}
        </ul>
        <p class="muted otros-p">¿Dudas sobre este documento? Escríbenos a <a href={`mailto:${SITIO.correo}`}>{SITIO.correo}</a> o abre un ticket en <a href="/soporte/">soporte</a>.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .cabecera { padding-top: clamp(28px, 4vw, 56px); padding-bottom: clamp(20px, 3vw, 36px); }
  .aviso { margin-bottom: 18px; }
  .migas ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 14px; color: var(--dk-muted); margin-bottom: 20px; }
  .migas li + li::before { content: '›'; margin-right: 10px; color: var(--dk-muted); }
  h1 { font-size: clamp(34px, 4.2vw, 58px); margin: 10px 0 14px; max-width: 22ch; }
  .fecha { font-size: 15px; }

  .cuerpo { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 48px; align-items: start; padding-bottom: clamp(48px, 6vw, 96px); }
  .indice { position: sticky; top: 96px; padding: 20px; max-height: calc(100vh - 120px); overflow: auto; }
  .indice-titulo { font-family: var(--font-title); font-weight: 700; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dk-lila-link); margin-bottom: 10px; }
  .indice ol { padding-left: 1.4em; display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.4; }
  .indice li::marker { color: var(--dk-muted); font-variant-numeric: tabular-nums; }
  .indice a { display: block; padding: 4px 0; color: var(--dk-soft); }
  .indice a:hover { color: #F0D4FF; }
  @media (max-width: 1024px) {
    .cuerpo { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .indice { position: static; max-height: none; }
    .indice ol { columns: 2; column-gap: 24px; }
  }
  @media (max-width: 640px) { .indice ol { columns: 1; } }

  .texto { min-width: 0; }
  .legal { font-size: 17px; }
  .legal :global(h2) { scroll-margin-top: 96px; font-size: clamp(24px, 2.4vw, 32px); padding-top: 0.6em; border-top: 1px solid var(--dk-line); }
  .legal :global(h3) { scroll-margin-top: 96px; font-size: 20px; }
  .legal :global(.table-box) { margin-bottom: 1.2em; border: 1px solid var(--dk-line); border-radius: var(--r-card); }
  .legal :global(.table-box table) { margin-bottom: 0; min-width: 640px; }
  .legal :global(.table-box th), .legal :global(.table-box td) { padding: 12px 14px; }
  .legal :global(.table-box tr:last-child td) { border-bottom: 0; }
  @media (max-width: 720px) {
    .legal :global(.table-box)::before { content: 'Desliza para ver toda la tabla'; display: block; padding: 8px 14px 0; font-size: 12px; color: var(--dk-muted); }
  }
  .legal :global(blockquote p) { margin-bottom: 0; }
  .legal :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; background: var(--dk-surface-2); padding: 2px 6px; border-radius: 4px; }

  .otros { margin-top: 40px; }
  .otros-titulo { font-family: var(--font-title); font-weight: 700; font-size: 20px; margin-bottom: 12px; }
  .otros-p { margin-top: 16px; font-size: 15px; }
</style>
