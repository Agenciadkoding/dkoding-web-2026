---
/** Seguimiento incluido: cada sitio queda conectado al panel de agencia. Panel de ejemplo con datos entre corchetes. */
const vigilamos = [
  'Disponibilidad cada 5 minutos',
  'Velocidad real (Core Web Vitals)',
  'Copias de seguridad periódicas',
  'Posiciones y clics en Google',
  'Integridad del servidor (cPanel)',
  'Alertas por WhatsApp y correo',
];
const dias = Array.from({ length: 30 }, (_, i) => (i === 12 ? 'aviso' : 'ok'));
---
<section class="seg" id="seguimiento" aria-labelledby="h-seguimiento">
  <div class="container seg-in">
    <div class="seg-copy reveal">
      <p class="eyebrow">Seguimiento incluido</p>
      <h2 id="h-seguimiento">Tu sitio no se lanza y se olvida: <strong>lo vigilamos todos los días</strong></h2>
      <p class="lead">Cada sitio que entregamos queda conectado a nuestro panel de agencia. Si se cae, si se vuelve lento o si Google deja de mostrarlo, lo sabemos antes que tú, y actuamos.</p>
      <ul class="chev-list vigilamos">
        {vigilamos.map((v) => <li>{v}</li>)}
      </ul>
    </div>

    <div class="panel reveal" aria-label="Panel de agencia, vista de ejemplo">
      <div class="panel-cab"><span class="panel-titulo">Panel de agencia · tu-sitio.com</span><span class="pill pill-ok">Vista de ejemplo</span></div>
      <div class="panel-kpis">
        <div class="kpi"><span class="kpi-l">Disponibilidad 30 días</span><span class="kpi-v">[__ %]</span><span class="kpi-ok">Objetivo ≥ 99,9 %</span></div>
        <div class="kpi"><span class="kpi-l">Carga (LCP p75)</span><span class="kpi-v">[__ s]</span><span class="kpi-ok">Objetivo &lt; 1,8 s</span></div>
        <div class="kpi"><span class="kpi-l">Última copia</span><span class="kpi-v">[hoy]</span><span class="kpi-ok">Diaria, 30 versiones</span></div>
      </div>
      <div class="panel-bloque">
        <span class="kpi-l">Disponibilidad · últimos 30 días</span>
        <div class="dias" aria-hidden="true">{dias.map((d) => <span class:list={['dia', d]}></span>)}</div>
      </div>
      <ul class="eventos">
        <li><span class="ev"><span class="punto ok" aria-hidden="true"></span>Copia de seguridad completada</span><span class="muted">[fecha]</span></li>
        <li><span class="ev"><span class="punto ok" aria-hidden="true"></span>Certificado SSL renovado</span><span class="muted">[fecha]</span></li>
        <li><span class="ev"><span class="punto aviso" aria-hidden="true"></span>Alerta: velocidad por debajo del objetivo, resuelta</span><span class="muted">[fecha]</span></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .seg { background: #0F0F11; border-top: 1px solid var(--dk-line); border-bottom: 1px solid var(--dk-line); }
  .seg-in { padding-block: clamp(56px, 6vw, 72px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; align-items: center; }
  .seg-copy { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .vigilamos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; color: var(--dk-soft); margin-top: 8px; }
  .panel { min-width: 0; padding: 24px; background: var(--dk-surface); border: 1px solid var(--dk-line-2); border-radius: 10px; box-shadow: 0 30px 80px rgba(0,0,0,0.5); display: flex; flex-direction: column; gap: 18px; }
  .panel-cab { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .panel-titulo { font-weight: 600; }
  .panel-kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .kpi { padding: 16px; background: #0F0F11; border: 1px solid var(--dk-line); border-radius: 6px; display: flex; flex-direction: column; gap: 6px; }
  .kpi-l { font-size: 12px; color: var(--dk-muted); }
  .kpi-v { font-family: var(--font-title); font-weight: 700; font-size: 26px; line-height: 1; }
  .kpi-ok { font-size: 12px; color: var(--dk-ok); }
  .panel-bloque { display: flex; flex-direction: column; gap: 8px; }
  .dias { display: grid; grid-template-columns: repeat(30, minmax(0, 1fr)); gap: 3px; }
  .dia { height: 28px; border-radius: 2px; background: #2F8F5F; }
  .dia.aviso { background: #B8862B; }
  .eventos { list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .eventos li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; background: #0F0F11; border-radius: 6px; border: 1px solid rgba(255,255,255,0.06); }
  .ev { display: flex; gap: 10px; align-items: center; }
  .punto { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .punto.ok { background: var(--dk-ok); }
  .punto.aviso { background: var(--dk-warn); }
  @media (max-width: 1024px) { .seg-in { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .vigilamos { grid-template-columns: minmax(0, 1fr); }
    .panel { padding: 18px; }
    .panel-kpis { grid-template-columns: minmax(0, 1fr); }
    .eventos li { flex-direction: column; gap: 4px; }
  }
</style>
