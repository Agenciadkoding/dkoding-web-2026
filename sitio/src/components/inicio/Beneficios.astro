---
/** Beneficios clave (5) sobre fondo claro. */
import { WA_GENERAL } from '../../data/sitio';
const items = [
  { t: 'Más tráfico orgánico', d: 'Arquitectura y contenidos optimizados para palabras clave con intención.', ico: 'M3 17l6-6 4 4 8-8M14 7h7v7' },
  { t: 'Más leads', d: 'Formularios simples, UX enfocada en conversión y pruebas A/B.', ico: 'M16 11a4 4 0 1 0-8 0 4 4 0 0 0 8 0zM4 21a8 8 0 0 1 16 0' },
  { t: 'Más velocidad', d: 'Imágenes de nueva generación, caché, minificación y carga diferida.', ico: 'M13 2L4 14h7l-1 8 9-12h-7z' },
  { t: 'Mejor ranking', d: 'SEO técnico: schema, sitemaps, enlazado interno, Core Web Vitals.', ico: 'M21 21l-4.3-4.3M8 11h6M11 8v6', circulo: true },
  { t: 'Trazabilidad total', d: 'GA4, Pixel y etiquetas, más tableros de rendimiento.', ico: 'M7 14l3-3 3 2 4-5M8 22h8', rect: true, destacado: true },
];
---
<section class="beneficios" id="beneficios" aria-labelledby="h-beneficios">
  <img class="deco deco-a" src="/img/deco/dkoding-deco-04.svg" alt="" aria-hidden="true" width="626" height="917" loading="lazy" decoding="async">
  <img class="deco deco-b" src="/img/deco/dkoding-deco-03.svg" alt="" aria-hidden="true" width="361" height="534" loading="lazy" decoding="async">
  <div class="container beneficios-in">
    <div class="cabecera reveal">
      <p class="eyebrow eyebrow-oscuro">Beneficios clave</p>
      <h2 id="h-beneficios"><strong>Resultados que importan</strong> al negocio</h2>
      <p class="intro">No vendemos "páginitas". Entregamos plataformas web rápidas y posicionables que reducen el costo por lead y aumentan la tasa de conversión desde el primer mes.</p>
    </div>
    <ul class="grid grid-5 lista">
      {items.map((it) => (
        <li class:list={['item reveal', { 'item-destacado': it.destacado }]}>
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {it.circulo && <circle cx="11" cy="11" r="7"/>}
            {it.rect && <rect x="3" y="4" width="18" height="14" rx="2"/>}
            <path d={it.ico}/>
          </svg>
          <h3>{it.t}</h3>
          <p>{it.d}</p>
        </li>
      ))}
    </ul>
    <div class="centro">
      <a href={WA_GENERAL} class="btn btn-primary" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/></svg>
        Quiero una cotización senior
      </a>
    </div>
  </div>
</section>

<style>
  .beneficios { position: relative; overflow: hidden; background: #F4F2F8; color: var(--dk-bg); isolation: isolate; }
  .deco { position: absolute; pointer-events: none; z-index: 0; }
  .deco-a { left: -10%; top: -30%; width: 34%; opacity: 0.35; animation: flota2 16s ease-in-out infinite; }
  .deco-b { right: 4%; bottom: -24%; width: 12%; opacity: 0.55; animation: flota 12s ease-in-out infinite; }
  .beneficios-in { position: relative; z-index: 1; padding-block: clamp(56px, 6vw, 72px); display: flex; flex-direction: column; gap: 40px; }
  .cabecera { display: flex; flex-direction: column; gap: 14px; max-width: 760px; margin-inline: auto; text-align: center; align-items: center; }
  .eyebrow-oscuro { color: var(--dk-violet); }
  .beneficios h2 strong { color: var(--dk-violet); }
  .intro { color: #5C5968; font-size: 18px; text-wrap: pretty; }
  .lista { list-style: none; }
  .item { display: flex; flex-direction: column; gap: 12px; padding: 26px 22px; background: #fff; border: 1px solid rgba(12,12,12,0.08); border-radius: var(--r-card); box-shadow: 0 12px 30px rgba(61,10,110,0.08); color: var(--dk-violet); }
  .item h3 { font-size: 21px; color: var(--dk-bg); }
  .item p { color: #5C5968; font-size: 14px; }
  .item-destacado { background: linear-gradient(135deg, var(--dk-violet), var(--dk-violet-dark)); border-color: rgba(255,255,255,0.12); color: #fff; box-shadow: 0 16px 40px rgba(109,0,194,0.35); }
  .item-destacado h3 { color: #fff; }
  .item-destacado p { color: #EADFF7; }
  .centro { display: flex; justify-content: center; }
  @keyframes flota { 0%, 100% { transform: translate3d(0,0,0) rotate(0); } 50% { transform: translate3d(0,-28px,0) rotate(3deg); } }
  @keyframes flota2 { 0%, 100% { transform: translate3d(0,0,0) rotate(0); } 50% { transform: translate3d(18px,22px,0) rotate(-4deg); } }
</style>
