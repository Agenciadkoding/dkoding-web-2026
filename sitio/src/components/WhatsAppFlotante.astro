---
import { WA_GENERAL } from '../data/sitio';
---
<a href={WA_GENERAL} class="wa-float" rel="noopener" target="_blank" aria-label="Escríbenos por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/><path d="M9.5 9.5c0 3 2 5 5 5l1-1.5-2-1-1 1c-1-.5-1.5-1-2-2l1-1-1-2-1 1z" fill="currentColor" stroke="none"/></svg>
  <span>WhatsApp</span>
</a>
<style>
  .wa-float { position: fixed; right: 16px; bottom: 16px; z-index: 45; display: inline-flex; align-items: center; gap: 8px; min-height: 52px; padding: 0 18px 0 14px; border-radius: 999px; background: var(--dk-wa); color: var(--dk-bg); font-weight: 700; font-size: 15px; box-shadow: 0 10px 30px rgba(37, 211, 102, 0.35); }
  .wa-float:hover { background: #3BE07A; color: var(--dk-bg); }
  @media (max-width: 640px) { .wa-float span { display: none; } .wa-float { padding: 0; width: 56px; height: 56px; justify-content: center; } }
</style>
